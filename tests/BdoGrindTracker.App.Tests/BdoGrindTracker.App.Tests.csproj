<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\WindowsOcrAttributes.cs" Link="TestSupport\WindowsOcrAttributes.cs" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\src\BdoGrindTracker.App\BdoGrindTracker.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\fixtures\rotation\*.json" Link="fixtures\rotation\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\fixtures\garmoth\*.json" Link="fixtures\garmoth\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\fixtures\lifetime\*.txt" Link="fixtures\lifetime\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\fixtures\companion-counter-v1.jsonl" Link="fixtures\companion-counter-v1.jsonl"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\fixtures\loot-scroll\*.png" Link="fixtures\loot-scroll\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\fixtures\agris\*.png" Link="fixtures\agris\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\fixtures\experience\*.png" Link="fixtures\experience\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\fixtures\experience\*.json" Link="fixtures\experience\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\fixtures\normal-appearance\*.png" Link="fixtures\normal-appearance\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\fixtures\quantity-confidence\*.png" Link="fixtures\quantity-confidence\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
