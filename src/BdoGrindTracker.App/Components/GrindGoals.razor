@page "/grind-goals"
@inherits TrackerComponentBase
@inject GrindGoalStore Goals

@{
    // Share one projection across the calendar, month summary and selected day.
    var daily = _dailyNet.Update(Tracker.History);
    var monthGoals = Goals.Goals.Where(g => g.Key.Year == _month.Year && g.Key.Month == _month.Month).ToArray();
    var monthReached = monthGoals.Count(g => daily.GetValueOrDefault(g.Key) >= g.Value);
    var dailyDrops = GrindGoalStore.DailyDrops(Tracker.History, name =>
    Tracker.Preferences.FavoriteItems.Contains(name, StringComparer.Ordinal) ||
    Tracker.Prices.TryGetQuote(name, out var quote) && quote.UnitPrice > 200_000_000m); }

<div class="page menu-page grind-goals">
    <div class="page-heading settings-page-heading"><h1>Grind Goals</h1></div>
    @if (_error is not null || Goals.Error is not null) { <div class="notice error-notice" role="alert">@T(_error ?? Goals.Error ?? "")</div> }
    <div class="settings-workspace menu-workspace">
        <MenuNavigation Label="Zielbereiche" Sections="Sections" Selected="@SelectedSection" />
        <div class="menu-content">
            <section class="menu-panel gg-planner" hidden="@(SelectedSection != "calendar")" aria-label="@T("Kalender & Ziele")">
                <div class="gg-toolbar">
                    <button class="button secondary" aria-label="@T("Vorheriger Monat")" @onclick="() => MoveMonth(-1)">‹</button>
                    <h2>@_month.ToString("MMMM yyyy", UiCulture)</h2>
                    <button class="button secondary" aria-label="@T("Nächster Monat")" @onclick="() => MoveMonth(1)">›</button>
                    <span>@F("{0} / {1} Tagesziele erreicht", monthReached, monthGoals.Length)</span>
                </div>
                <div class="gg-layout">
                    <section class="gg-calendar" aria-label="@T("Monatsübersicht")">
                        <div class="gg-week gg-labels"><span>@T("Woche")</span>@foreach (var day in Enumerable.Range(0, 7).Select(index => UiCulture.DateTimeFormat.GetAbbreviatedDayName((DayOfWeek)((index + 1) % 7)))) { <span>@day.TrimEnd('.')</span> }</div>
                        @for (var row = 0; row < WeekCount; row++)
                        {
                            var start = GridStart.AddDays(row*7);
                            <div class="gg-week @(start == _week ? "selected" : "")">
                                <button class="gg-week-select" aria-label="@F("Woche ab {0}", start.ToString("m", UiCulture))" aria-pressed="@(start == _week)" @onclick="() => SelectWeek(start)">@T("KW") @ISOWeek.GetWeekOfYear(start.ToDateTime(TimeOnly.MinValue))</button>
                                @for (var column = 0; column < 7; column++)
                                {
                                    var date = start.AddDays(column); var goal = Goals.Goals.GetValueOrDefault(date); var net = daily.GetValueOrDefault(date);
                                    <button class="gg-day @(date.Month != _month.Month ? "outside" : "") @(date == _day ? "chosen" : "") @(goal > 0 && net >= goal ? "reached" : "")" aria-pressed="@(date == _day)" @onclick="() => SelectDay(date)">
                                        <span>@date.Day</span><strong>@Silver(net)</strong><small>@(goal > 0 ? F("von {0}", Silver(goal)) : T("Kein Ziel"))</small>
                                        @if (goal > 0) { <progress value="@Math.Clamp(net,0,goal)" max="@goal" aria-label="@T("Zielfortschritt")"></progress> }
                                        @if (dailyDrops.TryGetValue(date, out var drops) && drops.Length > 0)
                                        {
                                            <span class="gg-drops">
                                                @foreach (var drop in drops)
                                                {
                                                    var favorite = Tracker.Preferences.FavoriteItems.Contains(drop.Key, StringComparer.Ordinal);
                                                    var label = ItemLabel(drop.Key) + " · " + Number(drop.Value) + (favorite ? " · " + T("Favorit") : "");
                                                    <span class="gg-drop" title="@label" aria-label="@label">
                                                        <AssetImage Src="@ItemIcon(drop.Key)" Alt="" Class="gg-drop-icon" Fallback="loot" />
                                                        <span class="gg-drop-count">@Number(drop.Value)</span>
                                                        @if (favorite) { <span class="gg-drop-star" aria-hidden="true">★</span> }
                                                    </span>
                                                }
                                            </span>
                                        }
                                    </button>
                                }
                            </div>
                        }
                    </section>
                    <section class="gg-editor">
                        <div class="gg-editor-heading"><h2>@_day.ToString("dddd", UiCulture), @_day.ToString("m", UiCulture)</h2><p>@T("Netto:") <strong>@Silver(daily.GetValueOrDefault(_day))</strong></p></div>
                        <div class="gg-editor-fields">
                            <label class="oe-field"><span>@T("Tagesziel in Mio. Silber")</span><input type="number" min="0.001" step="1" @bind="_millions" /></label>
                            <label class="oe-field"><span>@T("Anwenden auf")</span><select @bind="_scope"><option value="day">@T("Ausgewählter Tag")</option><option value="work">@T("Arbeitstage · Mo–Fr")</option><option value="weekend">@T("Wochenendtage · Sa–So")</option><option value="all">@T("Alle Tage")</option></select></label>
                            @if (_scope != "day") { <label class="oe-field"><span>@T("Zeitraum")</span><select @bind="_period"><option value="week">@T("Ausgewählte Woche")</option><option value="month">@T("Angezeigter Monat")</option></select></label> }
                        </div>
                        <div class="gg-editor-actions">
                            <button class="button primary" @onclick="Save">@T("Ziel speichern")</button>
                            <button class="button secondary" @onclick="Remove">@T("Ziel entfernen")</button>
                        </div>
                        @if (_saved is { } saved) { <p role="status">@(saved.Count == 1 ? T(saved.Removed ? "Tagesziel entfernt." : "Tagesziel gespeichert.") : F(saved.Removed ? "{0} Tagesziele entfernt." : "{0} Tagesziele gespeichert.", saved.Count))</p> }
                    </section>
                </div>
                @if (Tracker.History.Any(s => !s.SilverIsComplete && DateOnly.FromDateTime(s.StartedAt.LocalDateTime).Month == _month.Month && s.StartedAt.LocalDateTime.Year == _month.Year))
                { <p class="notice">@T("Einige Sessions enthalten unvollständige Silberwerte. Ihr bisher bekannter Nettowert zählt zum Fortschritt.")</p> }
            </section>
            <div class="gg-summary-view" hidden="@(SelectedSection != "summary")">
                <div class="menu-panel gg-day-navigation">
                    <button class="button secondary" aria-label="@T("Vorheriger Tag")" @onclick="() => MoveDay(-1)">‹</button>
                    <label class="gg-date-field"><span>@T("Tag")</span><input type="date" value="@_day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" @onchange="SelectDate" /></label>
                    <button class="button secondary" aria-label="@T("Nächster Tag")" @onclick="() => MoveDay(1)">›</button>
                </div>
                <div class="history-menu-content"><GrindGoalDaySummary Day="_day" /></div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "section")] public string? Section { get; set; }
    private static readonly MenuSection[] Sections =
    [
        new("calendar", "Kalender & Ziele", "trend", "grind-goals"),
        new("summary", "Tagesübersicht", "history", "grind-goals?section=summary"),
    ];
    private string SelectedSection => Section == "summary" ? "summary" : "calendar";
    private readonly DailyNetProjection _dailyNet = new();
    private DateOnly _month = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateOnly _day = DateOnly.FromDateTime(DateTime.Today), _week;
    private decimal _millions = 1000;
    private string _scope = "day", _period = "week";
    private string? _error;
    private (int Count, bool Removed)? _saved;
    private DateOnly GridStart => Monday(_month);
    private int WeekCount => (DateTime.DaysInMonth(_month.Year,_month.Month)+_month.DayNumber-GridStart.DayNumber+6)/7;
    private static DateOnly Monday(DateOnly date) => date.AddDays(-((int)date.DayOfWeek+6)%7);
    protected override void OnInitialized() { base.OnInitialized(); Goals.Load(); SelectDay(_day); }
    private void MoveMonth(int delta) { _month = _month.AddMonths(delta); SelectDay(_month); }
    private void MoveDay(int delta) => ChangeDay(_day.AddDays(delta));
    private void SelectDate(ChangeEventArgs args)
    {
        if (DateOnly.TryParseExact(args.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
            ChangeDay(date);
    }
    private void ChangeDay(DateOnly date) { _month = new(date.Year, date.Month, 1); SelectDay(date); }
    private void SelectDay(DateOnly date) { _day = date; _week = Monday(date); _millions = Goals.Goals.GetValueOrDefault(date,1_000_000_000)/1_000_000; _saved = null; }
    private void SelectWeek(DateOnly date) { SelectDay(date < _month ? _month : date); }
    private IEnumerable<DateOnly> SelectedDates()
    {
        if (_scope == "day") return [_day];
        var start = _period == "month" ? _month : _week;
        var count = _period == "month" ? DateTime.DaysInMonth(_month.Year,_month.Month) : 7;
        return Enumerable.Range(0,count).Select(start.AddDays).Where(d => d.Month == _month.Month && d.Year == _month.Year)
            .Where(d => _scope == "all" || (_scope == "weekend") == (d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday));
    }
    private void Save() => Apply(false);
    private void Remove() => Apply(true);
    private void Apply(bool remove)
    {
        try { if (!remove && _millions <= 0) throw new ArgumentException("Bitte ein Tagesziel größer als 0 eingeben.");
            var dates = SelectedDates().ToArray(); Goals.Set(dates, remove ? null : checked(_millions*1_000_000));
            _error = null; _saved = (dates.Length, remove); }
        catch (Exception e) when (e is IOException or UnauthorizedAccessException or ArgumentException or OverflowException) { _error = e.Message; _saved = null; }
    }
}
