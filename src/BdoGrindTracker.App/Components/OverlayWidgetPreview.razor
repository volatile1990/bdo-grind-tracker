@using BdoGrindTracker.App.Overlay

<div class="overlay-widget-viewport" data-content-width="@Css(Content.ReferenceWidth)" data-content-height="@Css(Content.ReferenceHeight)"
     data-min-content-width="@Css(Content.MinimumWidth)" data-min-content-height="@Css(Content.MinimumHeight)" data-content-layout="@PreviewStyle">
<div class="overlay-widget-preview overlay-widget-@Widget.Kind @(IsLoot ? "is-loot-widget" : "") @(Metric.IsWarning ? "is-warning" : "") metric-tone-@Metric.Tone.ToString().ToLowerInvariant()" style="@PreviewStyle" title="@(IsClock ? Clock.Tooltip : IsLoot ? Loot.Detail : Metric.Tooltip ?? (Metric.IsWarning ? "Loot-Scroll ist nicht aktiv." : Metric.Detail))">
    @if (Widget.ShowLabel && Widget.Kind != "rotation-monitor")
    {
        <div class="overlay-widget-label" data-overlay-fit>
            @if (Widget.ShowIcon) { <AppIcon Name="@(OverlayCatalog.Find(Widget.Kind)?.Icon ?? "live")" /> }
            <span>@(IsClock ? Clock.Label : IsLoot ? Loot.Label : Metric.Label)</span>
        </div>
    }
    @if (IsLoot)
    {
        @if (Loot.Items.Count == 0)
        {
            <div class="overlay-widget-empty" data-overlay-fit>@(Widget.ItemFilter == "selected" || Widget.Kind == "drop-item" ? "Items im Editor auswählen" : Widget.ItemFilter == "rare" || Widget.Kind == "rare-drops" ? "Noch keine seltenen Drops" : "Noch keine Drops")</div>
        }
        else
        {
            <div class="overlay-loot-viewport">
            <div class="overlay-widget-items is-@(Widget.Kind == "drop-item" ? "card" : Widget.ItemView) @(Widget.ShowIcon ? "" : "without-icons")">
                @foreach (var item in Loot.VisibleItems)
                {
                    <div class="overlay-widget-item @(item.IsRare ? "is-rare" : "")" style="@ItemStyle(item)" title="@(item.Name + " · " + item.QuantityText)" @key="item.CanonicalName">
                        @if (Widget.ShowIcon) { <AssetImage Src="@item.IconPath" Alt="" Class="overlay-item-icon" /> }
                        <span class="overlay-item-name" data-overlay-fit>@item.Name</span>
                        <strong class="overlay-item-quantity" data-overlay-fit>@item.QuantityText</strong>
                    </div>
                }
            </div>
            </div>
            @if (Loot.HiddenCount > 0) { <span class="overlay-widget-more" data-overlay-fit title="Maximale Items in den Moduleinstellungen erhöhen">+ @Loot.HiddenCount weitere</span> }
        }
    }
    else if (IsClock)
    {
        <div class="overlay-clock-rows">
            @foreach (var row in Clock.Rows)
            {
                <div class="overlay-clock-row is-@row.Kind" data-overlay-fit>
                    @if (!Widget.ShowLabel && Widget.ShowIcon && row == Clock.Rows[0]) { <AppIcon Name="clock" /> }
                    <span class="overlay-clock-row-label">@row.Label</span>
                    <strong>@row.Value</strong>
                </div>
            }
        </div>
    }
    else if (Widget.Kind == "rotation-monitor")
    {
        <OverlayRotationTimeline State="Snapshot.Rotation" Mode="@Widget.RotationComparison" Colors="@Widget.RotationColors" />
    }
    else if (Widget.Kind == "controls")
    {
        <button type="button" class="overlay-tracking-button" data-overlay-fit disabled="@(!Interactive || !Snapshot.CanToggleTracking)"
                @onclick="OnToggleTracking" @onclick:stopPropagation @onpointerdown:stopPropagation>
            @if (Widget.ShowIcon) { <AppIcon Name="@(Snapshot.IsRunning ? "pause" : "play")" /> }
            <span>@Snapshot.TrackingButtonLabel</span>
        </button>
        @if (Widget.ShowNewSession)
        {
            <button type="button" class="overlay-tracking-button" data-overlay-fit disabled="@(!Interactive || !Snapshot.CanNewSession)"
                    @onclick="OnNewSession" @onclick:stopPropagation @onpointerdown:stopPropagation>
                @if (Widget.ShowIcon) { <AppIcon Name="plus" /> }
                <span>Neue Session</span>
            </button>
        }
    }
    else if (Widget.Kind == "chart")
    {
        <strong class="overlay-widget-value" data-overlay-fit>
            @if (!Widget.ShowLabel && Widget.ShowIcon) { <AppIcon Name="trend" /> }
            <span class="overlay-value-text">@Metric.Value</span>
        </strong>
        @if (Snapshot.SilverHistory.Count >= 2)
        {
            <div style="position:relative;flex:1;min-height:0;overflow:hidden">
            <svg class="overlay-widget-chart" style="width:100%;height:100%;display:block" viewBox="0 0 300 72" preserveAspectRatio="none" role="img" aria-label="Verlauf des durchschnittlichen Silberwerts pro Stunde mit wertvollen Drops und Favoriten">
                <path d="M 0 71 H 300" class="overlay-chart-baseline" />
                <polygon points="@("0,72 " + ChartPoints + " 300,72")" class="overlay-chart-area" />
                <polyline points="@ChartPoints" class="overlay-chart-line" />
                @foreach (var marker in OverlayChartMarkers.Create(Snapshot))
                {
                    <line x1="@Css(marker.X * 300)" x2="@Css(marker.X * 300)" y1="@Css(marker.Y * 72)" y2="72" stroke="#f5ce73" stroke-width="2" vector-effect="non-scaling-stroke" />
                }
            </svg>
            @foreach (var marker in OverlayChartMarkers.Create(Snapshot))
            {
                <div style="position:absolute;left:clamp(12px,@Css(marker.X * 100)%,calc(100% - 12px));top:clamp(12px,@Css((marker.Y + 1) * 50)%,calc(100% - 12px));transform:translate(-50%,-50%);width:24px;height:24px;background:#252d33;border-radius:4px"
                     title="@(marker.Drop.Item.Name + " × " + marker.Drop.Item.QuantityText + " · " + marker.Drop.Elapsed.ToString(@"hh\:mm\:ss"))">
                    <AssetImage Src="@marker.Drop.Item.IconPath" Alt="@marker.Drop.Item.Name" Class="overlay-chart-drop-icon" />
                </div>
            }
            </div>
            <span class="overlay-widget-detail" data-overlay-fit>@Metric.Detail</span>
        }
        else
        {
            <div class="overlay-widget-empty" data-overlay-fit>Verlauf entsteht während des Grindens</div>
        }
    }
    else
    {
        <strong class="overlay-widget-value @(Widget.Kind == "status" ? "overlay-status-value" : "")" data-overlay-fit>
            @if (!Widget.ShowLabel && Widget.ShowIcon) { <AppIcon Name="@(OverlayCatalog.Find(Widget.Kind)?.Icon ?? "live")" /> }
            @if (Widget.Kind == "status") { <span class="overlay-status-dot @(Snapshot.IsRunning ? "is-running" : "")"></span> }
            <span class="overlay-value-text">@Metric.Value</span>
        </strong>
        @if ((Widget.ShowLabel || Widget.Kind == "experience") && Metric.Detail is not null && Widget.Kind is not "status")
        {
            <span class="overlay-widget-detail" data-overlay-fit>@Metric.Detail</span>
        }
    }
</div>
</div>

@code {
    [Parameter, EditorRequired] public OverlayWidget Widget { get; set; } = new();
    [Parameter, EditorRequired] public OverlaySnapshot Snapshot { get; set; } = new();
    [Parameter] public bool Interactive { get; set; }
    [Parameter] public EventCallback OnToggleTracking { get; set; }
    [Parameter] public EventCallback OnNewSession { get; set; }

    private OverlayMetric Metric => Snapshot.Metrics.GetValueOrDefault(Widget.Kind) ?? new(OverlayCatalog.Find(Widget.Kind)?.Label ?? "Modul", "—");
    private bool IsLoot => OverlayCatalog.IsLootWidget(Widget.Kind);
    private bool IsClock => Widget.Kind == "clock";
    private OverlayClockView? _clock;
    private OverlayClockView Clock => _clock ??= OverlayClockPresentation.Create(Widget, Snapshot.ClockUtcNow);
    private OverlayContentLayout? _content;
    private OverlayContentLayout Content => _content ??= OverlayContentLayout.Create(Widget, Snapshot);
    private OverlayWidget LayoutWidget => Content.LayoutWidget;
    private OverlayLootView? _loot;
    private OverlayLootView Loot => _loot ??= OverlayLootPresentation.Create(LayoutWidget, Snapshot);
    protected override void OnParametersSet() { _loot = null; _content = null; _clock = null; }
    private string PreviewStyle => $"width:{Css(LayoutWidget.Width)}px;height:{Css(LayoutWidget.Height)}px;transform:scale({Css(Content.Scale)});--widget-font-scale:{FontScale}" +
        (IsLoot ? $";--loot-item-size:{Css(Loot.ItemSize)}px;--loot-gap:{Css(Loot.Gap)}px;--loot-columns:{Math.Max(1, Loot.Columns)};--loot-cell-width:{Css(Loot.CellWidth)}px;--loot-cell-height:{Css(Loot.CellHeight)}px;--loot-header-height:{Css(Loot.HeaderHeight)}px;--loot-footer-height:{Css(Loot.FooterHeight)}px;--loot-layout-width:{Css(LootWidth)}px;--loot-layout-height:{Css(LootHeight)}px" : "");
    private int LootRows => (int)Math.Ceiling((double)Loot.VisibleItems.Count / Math.Max(1, Loot.Columns));
    private double LootWidth => Loot.Columns * Loot.CellWidth + Math.Max(0, Loot.Columns - 1) * Loot.Gap;
    private double LootHeight => LootRows * Loot.CellHeight + Math.Max(0, LootRows - 1) * Loot.Gap;
    private string ItemStyle(OverlayLootItem item)
    {
        var iconSize = Widget.ShowIcon ? Math.Max(0, Math.Min(Loot.ItemSize, Math.Min(Loot.CellWidth * .35, Loot.CellHeight))) : 0;
        var textWidth = Math.Max(1, Loot.CellWidth - iconSize - (Widget.ShowIcon ? 3 * Loot.Gap : 0));
        var textHeight = Math.Max(1, Loot.CellHeight - 18 * Loot.FontScale);
        var fontSize = Math.Max(.1, Math.Min(30 * Loot.FontScale,
            Math.Min(textWidth / Math.Max(1, item.QuantityText.Length * .65), Math.Max(1, textHeight) / 1.2)));
        var listIconSize = Widget.ShowIcon ? Math.Min(Loot.ItemSize * .55, Math.Min(Loot.CellHeight, Loot.CellWidth * .5)) : 0;
        var listTextWidth = Math.Max(.1, Loot.CellWidth - listIconSize - (Widget.ShowIcon ? 2 : 1) * 1.5 * Loot.Gap);
        var countWidth = Widget.ItemView == "list" ? listTextWidth * .4 : Loot.CellWidth - 1.5 * Loot.Gap;
        var countSize = Math.Max(.1, Math.Min(13 * Loot.FontScale, Math.Max(1, countWidth) / Math.Max(1, item.QuantityText.Length * .65)));
        return $"--loot-card-icon-size:{Css(iconSize)}px;--loot-card-count-size:{Css(fontSize)}px;--loot-count-size:{Css(countSize)}px;--loot-list-icon-size:{Css(listIconSize)}px";
    }
    private static string Css(double value) => value.ToString("0.######", CultureInfo.InvariantCulture);
    private string FontScale => Css(IsLoot ? Loot.FontScale : LayoutWidget.FontScale);
    private string ChartPoints
    {
        get
        {
            var values = Snapshot.SilverHistory;
            if (values.Count == 0) return "";
            var maximum = Math.Max(1m, values.Max(point => point.SilverPerHour));
            var first = OverlayChartMarkers.FirstTick(Snapshot);
            var span = Math.Max(1, values[^1].Elapsed.Ticks - first);
            return string.Join(" ", values.Select(point =>
                (300m * (point.Elapsed.Ticks - first) / span).ToString("0.##", CultureInfo.InvariantCulture) + "," +
                (70m - Math.Clamp(point.SilverPerHour / maximum, 0, 1) * 64m).ToString("0.##", CultureInfo.InvariantCulture)));
        }
    }
}
