@inherits LocalizedComponentBase
@using BdoGrindTracker.App.Overlay

<div class="overlay-widget-viewport" data-content-width="@Css(Content.ReferenceWidth)" data-content-height="@Css(Content.ReferenceHeight)"
     data-min-content-width="@Css(Content.MinimumWidth)" data-min-content-height="@Css(Content.MinimumHeight)" data-content-layout="@PreviewStyle">
<div class="overlay-widget-preview overlay-widget-@Widget.Kind @(Widget.Kind == "chart" ? "session-timeline" : "") @(IsLoot ? "is-loot-widget" : "") @(Metric.IsWarning ? "is-warning" : "") metric-tone-@Metric.Tone.ToString().ToLowerInvariant()" style="@PreviewStyle" title="@T(IsClock ? Clock.Tooltip : IsLoot ? Loot.Detail : Metric.Tooltip ?? (Metric.IsWarning ? "Loot-Scroll ist nicht aktiv." : Metric.Detail ?? ""))">
    @if (Widget.ShowLabel && Widget.Kind != "rotation-monitor")
    {
        <div class="overlay-widget-label" data-overlay-fit>
            @if (Widget.ShowIcon) { <AppIcon Name="@(OverlayCatalog.Find(Widget.Kind)?.Icon ?? "live")" /> }
            <span>@T(IsClock ? Clock.Label : IsLoot ? Loot.Label : Metric.Label)</span>
            @if (Widget.Kind == "chart") { <small class="overlay-timeline-caption">@Timeline.Caption</small> }
        </div>
    }
    @if (IsLoot)
    {
        @if (Loot.Items.Count == 0)
        {
            <div class="overlay-widget-empty" data-overlay-fit>@(IsConsumables ? T("Noch keine verbrauchten Items") : Widget.ItemFilter == "selected" || Widget.Kind == "drop-item" ? T("Items im Editor auswählen") : Widget.ItemFilter == "rare" || Widget.Kind == "rare-drops" ? T("Noch keine seltenen Drops") : T("Noch keine Drops"))</div>
        }
        else
        {
            <div class="overlay-loot-viewport">
            <div class="overlay-widget-items is-@(IsConsumables ? "grid" : Widget.Kind == "drop-item" ? "card" : Widget.ItemView) @(Widget.ShowIcon ? "" : "without-icons")">
                @foreach (var item in Loot.VisibleItems)
                {
                    <div class="overlay-widget-item @(item.IsRare ? "is-rare" : "")" style="@ItemStyle(item)" title="@(item.Tooltip ?? item.Name + " · " + item.QuantityText)" @key="item.CanonicalName">
                        @if (Widget.ShowIcon) { <AssetImage Src="@item.IconPath" Alt="" Class="overlay-item-icon" /> }
                        <span class="overlay-item-name" data-overlay-fit>@item.Name</span>
                        <strong class="overlay-item-quantity" data-overlay-fit>@item.QuantityText</strong>
                    </div>
                }
                @for (var slot = 0; slot < OverlayLootPresentation.EmptySlotCount(Widget, Snapshot, Loot); slot++)
                {
                    <div class="overlay-widget-item is-empty-slot" aria-hidden="true"></div>
                }
            </div>
            </div>
            @if (Loot.HiddenCount > 0) { <span class="overlay-widget-more" data-overlay-fit title="@T("Maximale Items in den Moduleinstellungen erhöhen")">@F("+ {0} weitere", Loot.HiddenCount)</span> }
        }
        @if (IsConsumables)
        {
            <div class="overlay-consumables-cost @(Snapshot.Consumables.HasMissingPrices ? "is-incomplete" : "")" data-overlay-fit title="@Snapshot.Consumables.CostDescription">
                @if (Widget.ShowIcon) { <AppIcon Name="silver" /> }
                <strong>@Snapshot.Consumables.Cost</strong>
            </div>
        }
    }
    else if (IsClock)
    {
        <div class="overlay-clock-rows">
            @foreach (var row in Clock.Rows)
            {
                <div class="overlay-clock-row is-@row.Kind" data-overlay-fit>
                    @if (!Widget.ShowLabel && Widget.ShowIcon && row == Clock.Rows[0]) { <AppIcon Name="clock" /> }
                    <span class="overlay-clock-row-label">@T(row.Label)</span>
                    <strong>@row.Value</strong>
                </div>
            }
        </div>
    }
    else if (Widget.Kind == "rotation-monitor")
    {
        <OverlayRotationTimeline State="Snapshot.Rotation" Language="@UiLanguage" Mode="@Widget.RotationComparison" Colors="@Widget.RotationColors" />
    }
    else if (Widget.Kind == "daily-goal")
    {
        <strong class="overlay-widget-value" data-overlay-fit>@Snapshot.DailyGoal.Value</strong>
        <div class="overlay-daily-bar" role="progressbar" aria-label="@T("Fortschritt Tagesziel")" aria-valuenow="@(Snapshot.DailyGoal.Fraction*100)" aria-valuemin="0" aria-valuemax="100">
            <div class="overlay-daily-fill" style="width:@Css(Snapshot.DailyGoal.Fraction*100)%"></div>
            <span>@Snapshot.DailyGoal.Percentage</span>
        </div>
        <span class="overlay-widget-detail" data-overlay-fit>@Snapshot.DailyGoal.Detail</span>
    }
    else if (Widget.Kind == "grind-rating" && Metric.Spectrum is { } spectrum)
    {
        <strong class="overlay-widget-value overlay-grind-progress" data-overlay-fit title="@Metric.Value">
            @if (!Widget.ShowLabel && Widget.ShowIcon) { <AppIcon Name="trend" /> }
            <span class="overlay-value-text">@spectrum.ProgressLabel</span>
        </strong>
        <GrindRatingScale Value="spectrum" Compact="true" />
        <span class="overlay-widget-detail overlay-grind-gap" data-overlay-fit>@spectrum.GapLabel</span>
        @if (Metric.Detail is { } ratingDetail)
        {
            <span class="overlay-widget-detail overlay-grind-status" data-overlay-fit>@T(ratingDetail)</span>
        }
    }
    else if (Widget.Kind == "controls")
    {
        <button type="button" class="overlay-tracking-button" data-overlay-fit disabled="@(!Interactive || !Snapshot.CanToggleTracking)"
                @onclick="OnToggleTracking" @onclick:stopPropagation @onpointerdown:stopPropagation>
            @if (Widget.ShowIcon) { <AppIcon Name="@(Snapshot.IsRunning ? "pause" : "play")" /> }
            <span>@T(Snapshot.TrackingButtonLabel)</span>
        </button>
        @if (Widget.ShowNewSession)
        {
            <button type="button" class="overlay-tracking-button" data-overlay-fit disabled="@(!Interactive || !Snapshot.CanNewSession)"
                    @onclick="OnNewSession" @onclick:stopPropagation @onpointerdown:stopPropagation>
                @if (Widget.ShowIcon) { <AppIcon Name="plus" /> }
                <span>@T("Neue Session")</span>
            </button>
        }
    }
    else if (Widget.Kind == "chart")
    {
        @if (!Timeline.HasData)
        {
            <div class="overlay-widget-empty" data-overlay-fit>@T("Verlauf entsteht während des Grindens")</div>
        }
        else
        {
            <div class="overlay-timeline" role="img" aria-label="@T("Zeitstrahl der Session")">
                <div class="overlay-timeline-ticks">
                    @foreach (var tick in Timeline.Ticks)
                    {
                        <span class="@(tick.X > .85 ? "is-end" : null)" style="left:@Css(tick.X * 100)%">@tick.Label</span>
                    }
                </div>
                <div class="overlay-timeline-plot">
                    <svg viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
                        @foreach (var tick in Timeline.Ticks)
                        {
                            <line x1="@Css(tick.X * 1000)" x2="@Css(tick.X * 1000)" y1="0" y2="1000" class="overlay-timeline-grid" />
                        }
                        @if (Timeline.Trash is { } trash)
                        {
                            <g class="overlay-timeline-trash" style="--layer-color:@trash.Color">
                                @foreach (var bar in trash.Bars.Where(bar => bar.Value > 0))
                                {
                                    var top = OverlaySessionTimeline.Y(bar.Filled) * 1000;
                                    <rect x="@Css(bar.Start * 1000)" y="@Css(top)" width="@Css(Math.Max(.8, (bar.End - bar.Start) * 1000))" height="@Css(Math.Max(1, 1000 - top))" />
                                }
                            </g>
                        }
                        @if (Timeline.Silver is { Bars.Count: > 0 } silver)
                        {
                            var curve = string.Join(" ", silver.Bars.Select(bar => Css((bar.Start + bar.End) / 2 * 1000) + "," + Css(OverlaySessionTimeline.Y(bar.Filled) * 1000)));
                            <polygon class="overlay-timeline-silver-area" points="@($"{Css((silver.Bars[0].Start + silver.Bars[0].End) / 2 * 1000)},1000 {curve} {Css((silver.Bars[^1].Start + silver.Bars[^1].End) / 2 * 1000)},1000")" />
                            <polyline class="overlay-timeline-silver" points="@curve" />
                        }
                        <line x1="0" x2="1000" y1="1000" y2="1000" class="overlay-timeline-axis" />
                    </svg>
                    @foreach (var x in Timeline.SpecialEvents)
                    {
                        <span class="overlay-timeline-special" style="left:@Css(x * 100)%"></span>
                    }
                    @foreach (var marker in Timeline.Markers)
                    {
                        var drop = marker.Drops[0];
                        var top = $"clamp(0px, calc({Css(OverlaySessionTimeline.Y(marker.Height) * 100)}% - var(--timeline-icon) - 2px), calc(100% - var(--timeline-icon)))";
                        var left = $"clamp(calc(var(--timeline-icon) / 2), {Css(marker.X * 100)}%, calc(100% - var(--timeline-icon) / 2))";
                        <span class="overlay-timeline-stem" style="left:@left;top:calc(@top + var(--timeline-icon))"></span>
                        <div class="overlay-timeline-drop" style="left:@left;top:@top"
                             title="@(string.Join(" · ", marker.Drops.Select(entry => entry.Item.Name + " × " + entry.Item.QuantityText)) + " · " + drop.Elapsed.ToString(@"hh\:mm\:ss"))">
                            <AssetImage Src="@drop.Item.IconPath" Alt="@drop.Item.Name" Class="overlay-chart-drop-icon" />
                            @if (marker.Drops.Count > 1)
                            {
                                <span class="overlay-timeline-count">@marker.Drops.Count.ToString(CultureInfo.InvariantCulture)</span>
                            }
                        </div>
                    }
                </div>
                @if (Timeline.ShowsRotations)
                {
                    <div class="overlay-timeline-band @(Timeline.IsSimplified ? "is-simplified" : "is-phases")">
                        @foreach (var rotation in Timeline.Rotations)
                        {
                            var width = rotation.Right - rotation.Left;
                            var mechanics = rotation.Phases.FirstOrDefault(part => !part.IsAfk);
                            <div class="overlay-timeline-rotation is-@rotation.Status" style="left:calc(@Css(rotation.Left * 100)% + 1px);width:max(1px, calc(@Css(width * 100)% - 2px))"
                                 title="@(F("Rotation {0}", rotation.Span.Number) + " · " + RotationPhases.Duration(rotation.Span.Duration))">
                                @foreach (var part in rotation.Phases)
                                {
                                    var left = width <= 0 ? 0 : (part.Left - rotation.Left) / width * 100;
                                    var share = width <= 0 ? 0 : (part.Right - part.Left) / width * 100;
                                    <span class="overlay-timeline-phase @(part.IsAfk ? "is-afk" : null) @(part.IsSpecial ? "is-special" : null)"
                                          style="left:@Css(left)%;width:@Css(share)%@(Timeline.IsSimplified ? "" : $";background:{part.Color}")" title="@T(part.Name)">
                                        @if (Timeline.IsSimplified && part.IsAfk && (part.Right - part.Left) * PlotWidth >= 26 * LayoutWidget.FontScale) { <small>AFK</small> }
                                        @if (Timeline.IsSimplified && ReferenceEquals(part, mechanics) && (part.Right - part.Left) * PlotWidth >= 32 * LayoutWidget.FontScale) { <strong>@RotationPhases.Duration(rotation.Span.Duration)</strong> }
                                    </span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
        @if (Metric.Detail is { Length: > 0 } detail)
        {
            <span class="overlay-widget-detail" data-overlay-fit>@T(detail)</span>
        }
    }
    else
    {
        <strong class="overlay-widget-value @(Widget.Kind == "status" ? "overlay-status-value" : "")" data-overlay-fit>
            @if (!Widget.ShowLabel && Widget.ShowIcon) { <AppIcon Name="@(OverlayCatalog.Find(Widget.Kind)?.Icon ?? "live")" /> }
            @if (Widget.Kind == "status") { <span class="overlay-status-dot @(Snapshot.IsRunning ? "is-running" : "")"></span> }
            <span class="overlay-value-text">@T(Metric.Value)</span>
        </strong>
        @if ((Widget.ShowLabel || Widget.Kind == "experience") && Metric.Detail is not null && Widget.Kind is not "status")
        {
            <span class="overlay-widget-detail" data-overlay-fit>@T(Metric.Detail)</span>
        }
    }
</div>
</div>

@code {
    protected override string UiLanguage => Snapshot.UiLanguage;
    [Parameter, EditorRequired] public OverlayWidget Widget { get; set; } = new();
    [Parameter, EditorRequired] public OverlaySnapshot Snapshot { get; set; } = new();
    [Parameter] public bool Interactive { get; set; }
    [Parameter] public EventCallback OnToggleTracking { get; set; }
    [Parameter] public EventCallback OnNewSession { get; set; }

    private OverlayMetric Metric => Snapshot.Metrics.GetValueOrDefault(Widget.Kind) ?? new(OverlayCatalog.Find(Widget.Kind)?.Label ?? T("Modul"), "—");
    private bool IsConsumables => Widget.Kind == "consumables";
    private bool IsLoot => IsConsumables || OverlayCatalog.IsLootWidget(Widget.Kind);
    private bool IsClock => Widget.Kind == "clock";
    private OverlayClockView? _clock;
    private OverlayClockView Clock => _clock ??= OverlayClockPresentation.Create(Widget, Snapshot.ClockUtcNow);
    private OverlayContentLayout? _content;
    private OverlayContentLayout Content => _content ??= OverlayContentLayout.Create(Widget, Snapshot);
    private OverlayWidget LayoutWidget => Content.LayoutWidget;
    private OverlayLootView? _loot;
    private OverlayLootView Loot => _loot ??= OverlayLootPresentation.Create(LayoutWidget, Snapshot);
    protected override void OnParametersSet() { _loot = null; _content = null; _clock = null; _timeline = null; }
    private OverlaySessionTimeline? _timeline;
    // The preview's horizontal padding matches the native module's inset, so both group the same drop icons.
    private double PlotWidth => Math.Max(1, LayoutWidget.Width - 20);
    private OverlaySessionTimeline Timeline => _timeline ??= OverlaySessionTimeline.Create(LayoutWidget, Snapshot, PlotWidth);
    private string PreviewStyle => $"width:{Css(LayoutWidget.Width)}px;height:{Css(LayoutWidget.Height)}px;transform:scale({Css(Content.Scale)});--widget-font-scale:{FontScale}" +
        (IsLoot ? $";--loot-item-size:{Css(Loot.ItemSize)}px;--loot-gap:{Css(Loot.Gap)}px;--loot-columns:{Math.Max(1, Loot.Columns)};--loot-cell-width:{Css(Loot.CellWidth)}px;--loot-cell-height:{Css(Loot.CellHeight)}px;--loot-header-height:{Css(Loot.HeaderHeight)}px;--loot-footer-height:{Css(Loot.FooterHeight)}px;--loot-layout-width:{Css(LootWidth)}px;--loot-layout-height:{Css(LootHeight)}px" : "");
    private int LootRows => (int)Math.Ceiling((double)Loot.VisibleItems.Count / Math.Max(1, Loot.Columns));
    private double LootWidth => Loot.Columns * Loot.CellWidth + Math.Max(0, Loot.Columns - 1) * Loot.Gap;
    private double LootHeight => LootRows * Loot.CellHeight + Math.Max(0, LootRows - 1) * Loot.Gap;
    private string ItemStyle(OverlayLootItem item)
    {
        var iconSize = Widget.ShowIcon ? Math.Max(0, Math.Min(Loot.ItemSize, Math.Min(Loot.CellWidth * .35, Loot.CellHeight))) : 0;
        var textWidth = Math.Max(1, Loot.CellWidth - iconSize - (Widget.ShowIcon ? 3 * Loot.Gap : 0));
        var textHeight = Math.Max(1, Loot.CellHeight - 18 * Loot.FontScale);
        var fontSize = Math.Max(.1, Math.Min(30 * Loot.FontScale,
            Math.Min(textWidth / Math.Max(1, item.QuantityText.Length * .65), Math.Max(1, textHeight) / 1.2)));
        var listIconSize = Widget.ShowIcon ? Math.Min(Loot.ItemSize * .55, Math.Min(Loot.CellHeight, Loot.CellWidth * .5)) : 0;
        var listTextWidth = Math.Max(.1, Loot.CellWidth - listIconSize - (Widget.ShowIcon ? 2 : 1) * 1.5 * Loot.Gap);
        var countWidth = Widget.ItemView == "list" ? listTextWidth * .4 : Loot.CellWidth - 1.5 * Loot.Gap;
        var countSize = Math.Max(.1, Math.Min(13 * Loot.FontScale, Math.Max(1, countWidth) / Math.Max(1, item.QuantityText.Length * .65)));
        return $"--loot-card-icon-size:{Css(iconSize)}px;--loot-card-count-size:{Css(fontSize)}px;--loot-count-size:{Css(countSize)}px;--loot-list-icon-size:{Css(listIconSize)}px";
    }
    private static string Css(double value) => value.ToString("0.######", CultureInfo.InvariantCulture);
    private string FontScale => Css(IsLoot ? Loot.FontScale : LayoutWidget.FontScale);
}
