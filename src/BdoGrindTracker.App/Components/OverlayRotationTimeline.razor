@inherits LocalizedComponentBase
@using BdoGrindTracker.App.Overlay
<div class="rotation-timeline" title="@(State.SpotName + " · " + T(State.Status) + (State.ComparedSpecialEvents is { } compared ? " · " + BdoGrindTracker.App.Localization.AppText.Format("Referenz mit {0} Special Events", UiLanguage, compared) : "") + (State.Error is null ? "" : " · " + T(State.Error)))">
    @if (State.Error is not null) { <div class="rotation-sector" role="status">@T(State.Error)</div> }
    @if (RotationTimelinePresentation.ShowSetup(State))
    {
        <div class="rotation-setup" role="status"><strong>@RotationTimelinePresentation.SetupCount(State)</strong><span>@T(RotationTimelinePresentation.SetupHint)</span></div>
    }
    else
    {
    <svg viewBox="0 0 600 120" preserveAspectRatio="none" class="rotation-track" role="img" aria-label="@T("Rotation Monitor: Referenz oben, aktuelle Rotation unten")">
        @foreach (var group in RotationPhases.Create(State.SpotId, Reference?.Events ?? State.Events, Reference?.Duration ?? State.Elapsed, Colors).GroupBy(p => p.Group))
        {
            <rect x="@X(group.First().Start)" y="12" width="@Width(group.Last().End-group.First().Start)" height="98" rx="4" fill="@group.First().Color" fill-opacity=".18" />
            <rect x="@X(group.First().Start)" y="12" width="@Width(group.Last().End-group.First().Start)" height="3" fill="@group.First().GroupColor" />
            @if (group.Count() > 1 && (group.Last().End - group.First().Start) / Extent * 540 >= 40)
            {
                <g class="rotation-group-duration"><title>@(T(group.First().Group.StartsWith("cycle-", StringComparison.Ordinal) ? "Zyklus" : "Abschnitt") + " · " + RotationPhases.Duration(group.Last().End - group.First().Start))</title><text x="@X(group.Last().End)" y="9" text-anchor="end" fill="@group.First().GroupColor" font-size="10">@RotationPhases.Duration(group.Last().End - group.First().Start)</text></g>
            }
        }
        @foreach (var row in new[] { 0, 1 })
        {
            var current = row == 1 ? RotationCurrentRow.Create(State, Reference, Colors) : null;
            var events = current?.Events ?? Reference?.Events ?? [];
            var y = row == 0 ? 35 : 85;
            var end = current?.End ?? Reference?.Duration ?? 0;
            var phases = current?.Phases ?? RotationPhases.Create(State.SpotId, events, end, Colors);
            <line class="rotation-baseline" x1="0" x2="540" y1="@y" y2="@y" stroke="#44515c" stroke-width="2" />
            @if (current is { HasTrackingError: true })
            {
                <g class="rotation-tracking-error">
                    <title>@T(RotationCurrentRow.TrackingErrorTitle)</title>
                    <rect x="0" y="@(y-14)" width="@Width(current.ErrorEnd)" height="28" rx="2" fill="@RotationCurrentRow.TrackingErrorColor" fill-opacity=".2" stroke="@RotationCurrentRow.TrackingErrorColor" stroke-width="1.5" stroke-dasharray="4 3" vector-effect="non-scaling-stroke" />
                    @if (current.ErrorEnd / Extent * 540 >= 90)
                    {
                        <g><text x="@X(current.ErrorEnd / 2)" y="@(y+4)" text-anchor="middle" fill="@RotationCurrentRow.TrackingErrorColor" font-size="11">@T("Tracking-Fehler")</text></g>
                    }
                </g>
            }
            <g><text class="rotation-total-duration" x="598" y="@(y+4)" text-anchor="end" fill="#ffffff" font-size="12"><title>@(row == 0 ? T("Gesamtzeit der Referenzrotation") : T("Gesamtzeit der aktuellen Rotation"))</title>@(events.Count > 0 ? RotationPhases.Duration(end) : "–")</text></g>
            @foreach (var phase in phases)
            {
                <g class="rotation-phase" data-phase="@phase.Id">
                    <title>@((phase.Special ? T("Special Event") + " · " : "") + T(phase.Name) + " · " + RotationTimelinePresentation.Time(phase.Start) + "–" + RotationTimelinePresentation.Time(phase.End))</title>
                    <rect x="@X(phase.Start)" y="@(y-14)" width="@Width(phase.End-phase.Start)" height="28" rx="2" fill="@phase.Color" fill-opacity=".75" />
                    @if (phase.Special)
                    {
                        <rect class="rotation-special-event" x="@X(phase.Start)" y="@(y-14)" width="@Width(phase.End-phase.Start)" height="28" rx="2" fill="none" stroke="@RotationPhases.SpecialColor" stroke-width="2" stroke-dasharray="4 3" vector-effect="non-scaling-stroke" />
                    }
                    @if ((phase.End-phase.Start)/Extent*540 >= 28)
                    {
                        <g><text class="rotation-phase-duration" x="@X((phase.Start+phase.End)/2)" y="@(y+4)" text-anchor="middle" fill="#ffffff" font-size="11">@RotationPhases.Duration(phase.End-phase.Start)</text></g>
                    }
                </g>
            }
            @foreach (var e in events.Where(e => e.Seconds <= end))
            {
                <g>
                    <title>@(T(e.Label) + " · " + RotationTimelinePresentation.Time(e.Seconds) + (Mode == "sectors" && State.SectorBests.TryGetValue(e.Key, out var sector) ? T(" · Bestabschnitt ") + RotationTimelinePresentation.Time(sector) : ""))</title>
                    @if (RotationTimelinePresentation.IsMarker(e))
                    {
                        <line class="rotation-pack-marker" x1="@X(e.Seconds)" x2="@X(e.Seconds)" y1="@(y-18)" y2="@(y-11)" stroke="@RotationPhases.MarkerStroke(State.SpotId, e, Colors, row == 1)" stroke-width="2" vector-effect="non-scaling-stroke" />
                    }
                </g>
            }
        }
        @if (State.Synchronized || State.Events.Count > 0)
        {
            var now = State.Elapsed + RotationCurrentRow.OffsetOf(State, Reference);
            <line class="rotation-playhead" x1="@X(now)" x2="@X(now)" y1="0" y2="120" stroke="#ffffff" stroke-width="2" vector-effect="non-scaling-stroke" />
            <path class="rotation-playhead-tip" d="@($"M {X(now-Extent*.008)} 0 H {X(now+Extent*.008)} L {X(now)} 7 Z")" fill="#ffffff" />
        }
    </svg>
    @if (Mode == "sectors")
    {
        <div class="rotation-sector" data-overlay-fit>@RotationTimelinePresentation.Sector(State, UiLanguage)</div>
    }
    }
</div>
@code {
    [Parameter] public string? Language { get; set; }
    protected override string UiLanguage => Language ?? base.UiLanguage;
    [Parameter] public RotationMonitorSnapshot State { get; set; } = new();
    [Parameter] public string Mode { get; set; } = "best";
    [Parameter] public string Colors { get; set; } = "colored";
    private RotationRun? Reference => RotationTimelinePresentation.Reference(State, Mode);
    private double Extent => RotationTimelinePresentation.Extent(State, Mode);
    private string X(double seconds) => (Math.Clamp(seconds / Extent,0,1) * 540).ToString("0.###", CultureInfo.InvariantCulture);
    private string Width(double seconds) => Math.Max(0, Math.Clamp(seconds / Extent,0,1)*540-2).ToString("0.###", CultureInfo.InvariantCulture);
}
