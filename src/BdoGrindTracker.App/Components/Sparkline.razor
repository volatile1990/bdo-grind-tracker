@if (Values.Count > 1)
{
    <svg class="sparkline" viewBox="0 0 180 36" preserveAspectRatio="none" role="img" aria-label="@Label"><path d="@AreaPath" fill="currentColor" opacity="0.08" /><polyline points="@Points" fill="none" stroke="currentColor" stroke-width="1.7" vector-effect="non-scaling-stroke" /></svg>
}
@code {
    [Parameter] public IReadOnlyList<decimal> Values { get; set; } = [];
    [Parameter] public string Label { get; set; } = "Verlauf der gespeicherten Sessions";
    private string Points = "", AreaPath = "";
    protected override void OnParametersSet()
    {
        if (Values.Count < 2) { Points = AreaPath = ""; return; }
        var min = Values.Min();
        var range = Values.Max() - min;
        Points = string.Join(" ", Values.Select((value, index) =>
        {
            var x = index * 180m / (Values.Count - 1);
            var y = range == 0 ? 18 : 31 - (value - min) * 26 / range;
            return $"{x.ToString("0.##", CultureInfo.InvariantCulture)},{y.ToString("0.##", CultureInfo.InvariantCulture)}";
        }));
        AreaPath = "M0,36 L" + Points.Replace(" ", " L", StringComparison.Ordinal) + " L180,36 Z";
    }
}
