@if (Values.Count > 1)
{
    <svg class="sparkline" viewBox="0 0 180 36" preserveAspectRatio="none" role="img" aria-label="@Label"><path d="@AreaPath" fill="currentColor" opacity="0.08" /><polyline points="@Points" fill="none" stroke="currentColor" stroke-width="1.7" vector-effect="non-scaling-stroke" /></svg>
}
@code {
    [Parameter] public IReadOnlyList<decimal> Values { get; set; } = [];
    [Parameter] public string Label { get; set; } = "Verlauf der gespeicherten Sessions";
    private string Points => string.Join(" ", Values.Select((value, index) => $"{X(index).ToString("0.##", CultureInfo.InvariantCulture)},{Y(value).ToString("0.##", CultureInfo.InvariantCulture)}"));
    private string AreaPath => "M0,36 L" + Points.Replace(" ", " L", StringComparison.Ordinal) + " L180,36 Z";
    private decimal X(int index) => index * 180m / Math.Max(1, Values.Count - 1);
    private decimal Y(decimal value) { var min = Values.Min(); var range = Values.Max() - min; return range == 0 ? 18 : 31 - (value - min) * 26 / range; }
}
