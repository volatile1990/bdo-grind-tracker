@inherits TrackerComponentBase

<section class="panel settings-panel capture-configuration" aria-labelledby="capture-configuration-heading">
    <div class="settings-heading capture-configuration-heading">
        <div class="settings-icon"><AppIcon Name="monitor" /></div>
        <div><h2 id="capture-configuration-heading">Erfassungsbereiche prüfen</h2><p>BDO-Einstellungen und die beiden Lootbereiche im Spielbild vergleichen.</p></div>
        <button type="button" class="button secondary" aria-expanded="@(_open ? "true" : "false")" aria-controls="capture-configuration-content" @onclick="ToggleOpen" disabled="@Acting">@(_open ? "Schließen" : "Prüfen")</button>
    </div>
    @if (_open)
    {
        <div id="capture-configuration-content">
            <div class="capture-active-file" role="status">
                <strong>Aktuell verwendete Datei</strong>
                <code>@(_scan?.ActivePath ?? "Noch keine passende Datei ermittelt.")</code>
                <span>@(Tracker.Preferences.CaptureConfigurationPath is null ? "Automatische Auswahl" : "Fest ausgewählte Datei")</span>
            </div>
            @if (ActionError is not null) { <div class="notice error-notice" role="alert">@ActionError</div> }
            @if (_scan?.Error is { } scanError) { <div class="notice error-notice" role="alert">@scanError</div> }
            @if (_success is not null) { <div class="notice success-notice" role="status">@_success</div> }
            <div class="capture-actions">
                <button type="button" class="button secondary" @onclick="Scan" disabled="@Busy"><AppIcon Name="refresh" />Dateien erneut suchen</button>
                <button type="button" class="button secondary" @onclick="Browse" disabled="@Busy">Datei auswählen…</button>
            </div>
            <p class="field-note">Für die Vorschau markieren. Erst „Verwenden“ übernimmt die Auswahl.</p>
            <label class="capture-option capture-automatic">
                <input type="radio" name="capture-configuration-choice" checked="@(_selectedPath is null)" @onchange="ChooseAutomatic" disabled="@Busy" />
                <span><strong>Automatische Auswahl</strong><small>Verwendet das zuletzt gespeicherte Profil.</small></span>
            </label>
            <div class="capture-list-summary" role="status"><strong>@Candidates.Count(option => option.IsValid) verwendbar</strong><span>von @Candidates.Count gefundenen Dateien</span><span>· @Candidates.Count(option => option.IsValid && option.RareBounds is not null) mit beiden Droplog-Positionen</span></div>
            <div class="capture-list-tools">
                <label class="field capture-search"><span>Dateien durchsuchen</span><input type="search" value="@_query" @oninput="e => SetQuery(e.Value?.ToString() ?? string.Empty)" placeholder="Profil, Unterordner oder Dateipfad" disabled="@Busy" /></label>
                <label class="field"><span>Anzeigen</span><select value="@_filter" @onchange="e => SetFilter(e.Value?.ToString() ?? string.Empty)" disabled="@Busy"><option value="usable">Verwendbar (@Candidates.Count(option => option.IsValid))</option><option value="both">Beide Droplogs (@Candidates.Count(option => option.IsValid && option.RareBounds is not null))</option><option value="normal">Nur normales Droplog (@Candidates.Count(option => option.IsValid && option.RareBounds is null))</option><option value="invalid">Nicht verwendbar (@Candidates.Count(option => !option.IsValid))</option><option value="all">Alle Dateien (@Candidates.Count)</option></select></label>
                <label class="field"><span>Sortieren</span><select value="@_sort" @onchange="e => SetSort(e.Value?.ToString() ?? string.Empty)" disabled="@Busy"><option value="active">Aktive Datei zuerst</option><option value="recent">Zuletzt gespeichert</option><option value="path">Profil / Dateipfad</option></select></label>
            </div>
            <div class="capture-list-result"><span>@FilteredCandidates.Count von @Candidates.Count Dateien angezeigt</span>@if (_query.Length > 0 || _filter != "usable") { <button type="button" class="capture-text-button" @onclick="ResetFilters" disabled="@Busy">Filter zurücksetzen</button> }</div>
            <div class="capture-options" aria-label="Verfügbare BDO-Einstellungsdateien">
                <table class="capture-file-table">
                    <thead><tr><th scope="col">Profil / Datei</th><th scope="col">Gespeichert</th><th scope="col">Anzeige</th><th scope="col">Normales Droplog</th><th scope="col">Special-Droplog</th><th scope="col"><span class="capture-sr-only">Dateidetails</span></th></tr></thead>
                    <tbody>
                    @foreach (var option in FilteredCandidates)
                    {
                        <tr class="capture-file-row @(SamePath(_selectedPath, option.Path) ? "is-selected" : string.Empty)" data-config-path="@option.Path" @key="option.Path">
                            <td><label class="capture-file-choice"><input type="radio" name="capture-configuration-choice" checked="@SamePath(_selectedPath, option.Path)" @onchange="() => Choose(option)" disabled="@(Busy || !option.IsValid)" aria-label="@($"{CompactLabel(option)} für die Vorschau auswählen")" /><span class="capture-file-name" title="@option.Path">@CompactLabel(option)</span></label>@if (SamePath(_scan?.ActivePath, option.Path)) { <span class="capture-active-badge">Aktiv</span> }</td>
                            <td><span>@(option.LastWriteUtc?.ToLocalTime().ToString("dd.MM.yyyy", German) ?? "Unbekannt")</span><small>@(option.LastWriteUtc?.ToLocalTime().ToString("HH:mm", German))</small></td>
                            <td>@if (option.IsValid) { <span>@option.ScreenWidth × @option.ScreenHeight</span><small>@option.UiScale.ToString("P0", German) UI</small> } else { <span class="capture-muted">Nicht geprüft</span> }</td>
                            <td>@if (option.IsValid && option.NormalBounds is { } normalBounds) { <span>@PositionLabel(normalBounds)</span><small>@normalBounds.Width × @normalBounds.Height px</small> } else { <span class="capture-unusable">Nicht verwendbar</span> }</td>
                            <td>@if (option.IsValid && option.RareBounds is { } rareBounds) { <span>@PositionLabel(rareBounds)</span><small>@rareBounds.Width × @rareBounds.Height px</small> } else { <span class="capture-muted">@(option.IsValid ? "Keine Erfassung" : "Nicht geprüft")</span> }</td>
                            <td><button type="button" class="capture-text-button" @onclick="() => ToggleDetails(option.Path)" aria-expanded="@(SamePath(_expandedPath, option.Path) ? "true" : "false")" aria-label="@($"Details zu {CompactLabel(option)}")">@(SamePath(_expandedPath, option.Path) ? "Weniger" : "Details")</button></td>
                        </tr>
                        @if (SamePath(_expandedPath, option.Path))
                        {
                            <tr class="capture-file-details"><td colspan="6"><code>@option.Path</code>
                                @if (option.Error is { } error) { <p class="field-error" role="alert">@error</p> }
                                else
                                {
                                    <div class="capture-detail-values"><span>Normales Droplog: @BoundsLabel(option.NormalBounds)</span><span>Special-Droplog: @BoundsLabel(option.RareBounds)</span><span>Gespeichert: @ChangedAt(option.LastWriteUtc)</span></div>
                                    <p class="field-note">Special-Droplog: @option.RareStatus</p>
                                    @if (option.RareBounds is null) { <p class="field-note">Special-Drops werden mit dieser Konfiguration nicht erfasst.</p> }
                                }
                            </td></tr>
                        }
                    }
                    </tbody>
                </table>
                @if (FilteredCandidates.Count == 0) { <div class="capture-empty" role="status">Keine Dateien für diese Suche oder diesen Filter gefunden. Wähle einen anderen Filter oder suche nach einem anderen Profil.</div> }
            </div>
            <div class="capture-selection-summary"><span>Für die Vorschau ausgewählt: <strong>@SelectionLabel</strong></span>@if (_selectedPath is not null && !FilteredCandidates.Any(option => SamePath(option.Path, _selectedPath))) { <button type="button" class="capture-text-button" @onclick="ShowSelection" disabled="@Busy">Auswahl anzeigen</button> }</div>
            @if (SelectedOption is { IsValid: true, RareBounds: null }) { <p class="field-note">Special-Drops werden mit dieser Konfiguration nicht erfasst. Wähle „Beide Droplogs“, um Dateien mit beiden Positionen zu finden.</p> }
            @if (_scan is not null && Candidates.Count == 0) { <p class="field-note">Keine BDO-Einstellungsdatei gefunden. Du kannst eine Datei selbst auswählen.</p> }
            @if (State.IsRunning) { <p class="field-note">Für ein Vorschaubild zuerst die laufende Erfassung pausieren.</p> }
            @if (State.HasSession) { <p class="field-note">Die Dateiauswahl lässt sich vor dem Start einer neuen Session übernehmen.</p> }
            <p class="field-note">Ist die Special-Zeile verborgen, im BDO-Modus „UI bearbeiten“ die Lootanzeigen sichtbar machen.</p>
            <div class="capture-actions">
                <button type="button" class="button secondary" @onclick="Preview" disabled="@(Busy || State.IsRunning || !SelectionIsValid)"><AppIcon Name="refresh" />Vorschau aktualisieren</button>
                <button type="button" class="button primary" @onclick="Apply" disabled="@(Busy || State.HasSession || State.IsRunning || !CanApply)">@(_selectedPath is null ? "Automatische Auswahl verwenden" : "Verwenden")</button>
            </div>
            @if (Acting) { <p class="field-note" role="status">Wird geprüft…</p> }
            @if (_preview?.Error is { } previewError) { <div class="notice error-notice" role="alert">@previewError</div> }
            @if (_preview is { ImageDataUrl: not null, Configuration: { } configuration } preview)
            {
                <div class="capture-preview">
                    <div class="capture-preview-heading"><h3>Vorschaubild</h3><span>@(preview.CapturedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss", German) ?? "Zeitpunkt unbekannt")</span></div>
                    <code>@configuration.Path</code>
                    @if (preview.UsesSessionGeometry) { <p class="field-note">Erfassungsbereiche der pausierten Session. Eine geänderte Datei lässt sich für eine neue Session übernehmen.</p> }
                    <p class="field-note">Einzelaufnahme. Zum Vergleichen die Lootanzeigen im Spiel einblenden und die Vorschau aktualisieren.</p>
                    <div class="capture-legend"><span class="capture-normal-color">Türkis: normales Droplog</span><span class="capture-rare-color">Gold: Special-Droplog</span></div>
                    <svg class="capture-full-image" viewBox="@($"0 0 {configuration.ScreenWidth} {configuration.ScreenHeight}")" role="img" aria-label="Spielbild mit markierten Erfassungsbereichen">
                        <image href="@preview.ImageDataUrl" x="0" y="0" width="@configuration.ScreenWidth" height="@configuration.ScreenHeight" />
                        @if (configuration.NormalBounds is { } normal)
                        {
                            <rect class="capture-normal-rect" x="@normal.X" y="@normal.Y" width="@normal.Width" height="@normal.Height" fill="none" stroke="#72cbb7" stroke-width="3" vector-effect="non-scaling-stroke"><title>Normales Droplog: @BoundsLabel(normal)</title></rect>
                        }
                        @if (configuration.RareBounds is { } rare)
                        {
                            <rect class="capture-rare-rect" x="@rare.X" y="@rare.Y" width="@rare.Width" height="@rare.Height" fill="none" stroke="#efce91" stroke-width="3" vector-effect="non-scaling-stroke"><title>Special-Droplog: @BoundsLabel(rare)</title></rect>
                        }
                    </svg>
                    <div class="capture-crops">
                        @if (preview.NormalImageDataUrl is { } normalImage)
                        {
                            <figure class="capture-normal-crop"><figcaption>Normales Droplog</figcaption><div><img src="@normalImage" alt="Genauer Bildausschnitt des normalen Droplogs" /></div></figure>
                        }
                        @if (preview.RareImageDataUrl is { } rareImage)
                        {
                            <figure class="capture-rare-crop"><figcaption>Special-Droplog</figcaption><div><img src="@rareImage" alt="Genauer Bildausschnitt des Special-Droplogs" /></div></figure>
                        }
                        else { <p class="field-note">Special-Droplog: @configuration.RareStatus</p> }
                    </div>
                </div>
            }
        </div>
    }
</section>

<style>
    .capture-configuration { margin-top:20px }
    .capture-configuration-heading { align-items:center;flex-wrap:wrap }
    .capture-configuration-heading>div:nth-child(2) { flex:1;min-width:220px }
    .capture-configuration-heading p { font-size:13px;margin-top:5px }
    .capture-configuration code { display:block;overflow-wrap:anywhere;white-space:normal;font-size:12px;line-height:1.6;color:var(--muted) }
    .capture-active-file { display:grid;gap:6px;padding:14px 16px;margin-bottom:16px;background:#11171d;border:1px solid var(--line);border-radius:8px }
    .capture-active-file>span { color:var(--gold);font-size:13px }
    .capture-actions { display:flex;gap:10px;flex-wrap:wrap;margin:16px 0 }
    .capture-automatic { display:flex;align-items:flex-start;gap:10px;border:1px solid var(--line);background:#151a21;border-radius:8px;padding:12px 15px }
    .capture-automatic input,.capture-file-choice input { flex-shrink:0;accent-color:var(--gold);margin:3px 0 }
    .capture-automatic small { display:block;margin-top:4px;color:var(--muted) }
    .capture-list-summary { display:flex;flex-wrap:wrap;align-items:center;gap:5px 9px;margin:20px 0 14px;font-size:13px;color:var(--muted) }
    .capture-list-summary strong { color:var(--teal) }
    .capture-list-tools { display:grid;grid-template-columns:minmax(200px,1.4fr) minmax(180px,1fr) minmax(170px,1fr);gap:12px }
    .capture-list-tools .field { margin:0;min-width:0 }
    .capture-list-tools .field>span { font-size:12px }
    .capture-list-tools input,.capture-list-tools select { width:100%;min-width:0 }
    .capture-list-result { display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:36px;color:var(--muted);font-size:12px }
    .capture-options { max-height:420px;overflow:auto;overscroll-behavior:contain;border:1px solid var(--line);border-radius:7px;scrollbar-gutter:stable }
    .capture-file-table { width:100%;border-collapse:collapse;table-layout:fixed;min-width:640px;font-size:12px }
    .capture-file-table th { position:sticky;top:0;z-index:1;background:#1b222b;color:var(--muted);font-size:11px;font-weight:600;text-align:left;padding:10px 9px;white-space:normal;border-bottom:1px solid var(--line) }
    .capture-file-table th:first-child { width:27% }
    .capture-file-table th:nth-child(2) { width:13% }
    .capture-file-table th:nth-child(3) { width:14% }
    .capture-file-table th:nth-child(4),.capture-file-table th:nth-child(5) { width:18% }
    .capture-file-table th:last-child { width:10% }
    .capture-file-table td { padding:10px 9px;vertical-align:top;border-bottom:1px solid var(--line);font-variant-numeric:tabular-nums;overflow-wrap:anywhere }
    .capture-file-row:hover { background:#ffffff03 }
    .capture-file-row.is-selected { background:#d3ae6312 }
    .capture-file-row.is-selected td:first-child { box-shadow:inset 3px 0 var(--gold) }
    .capture-file-table small { display:block;margin-top:4px;color:var(--muted);font-size:11px }
    .capture-file-choice { display:flex;align-items:flex-start;gap:9px;cursor:pointer }
    .capture-file-name { font-weight:600;overflow-wrap:anywhere }
    .capture-active-badge { display:inline-block;margin:5px 0 0 22px;font-size:10px;color:var(--teal);border:1px solid #72cbb755;border-radius:4px;padding:1px 5px }
    .capture-muted { color:var(--muted) }
    .capture-unusable { color:#d79992 }
    .capture-text-button { border:0;background:transparent;color:var(--gold);padding:2px 0;font:inherit;font-size:12px;text-align:left;cursor:pointer }
    .capture-text-button:hover { text-decoration:underline }
    .capture-text-button:focus-visible { outline:2px solid var(--gold);outline-offset:3px }
    .capture-text-button:disabled { opacity:.5;cursor:default }
    .capture-file-details { background:#11171d }
    .capture-file-details td { padding:12px 15px }
    .capture-file-details .field-error { margin:8px 0 2px;max-width:850px;line-height:1.6 }
    .capture-file-details .field-note { margin:7px 0 0 }
    .capture-detail-values { display:flex;flex-wrap:wrap;gap:8px 22px;margin-top:9px;color:var(--muted);font-size:12px }
    .capture-empty { padding:22px;color:var(--muted);font-size:13px;line-height:1.6 }
    .capture-selection-summary { display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin:12px 0;font-size:12px;color:var(--muted);overflow-wrap:anywhere }
    .capture-selection-summary strong { color:var(--text) }
    .capture-sr-only { position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap }
    .capture-preview { border-top:1px solid var(--line);padding-top:20px;margin-top:20px }
    .capture-preview-heading { display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:8px }
    .capture-preview-heading>span { font-size:13px;color:var(--muted) }
    .capture-legend { display:flex;flex-wrap:wrap;gap:16px;margin:14px 0;font-size:13px }
    .capture-normal-color,.capture-normal-crop figcaption { color:var(--teal) }
    .capture-rare-color,.capture-rare-crop figcaption { color:var(--gold-bright) }
    .capture-full-image { display:block;width:100%;height:auto;background:#080b0f;border:1px solid var(--line);border-radius:7px }
    .capture-crops { display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:20px;margin-top:20px }
    .capture-crops figure { margin:0;min-width:0 }
    .capture-crops figcaption { font-weight:600;margin-bottom:9px }
    .capture-crops figure>div { overflow:auto;border:1px solid var(--line);background:#080b0f;padding:8px;border-radius:6px }
    .capture-crops img { display:block;max-width:100%;height:auto }
    @@media(max-width:1000px) { .capture-list-tools { grid-template-columns:1fr 1fr } .capture-search { grid-column:1/-1 } }
</style>

@code {
    private bool _open, _selectionInitialized;
    private string? _selectedPath, _previewSelectionPath, _success, _expandedPath;
    private string _query = "", _filter = "usable", _sort = "active";
    private CaptureConfigurationScan? _scan;
    private CaptureConfigurationOption? _browsed;
    private CaptureConfigurationPreview? _preview;
    private bool Busy => Acting || State.IsBusy;
    private IReadOnlyList<CaptureConfigurationOption> Candidates => (_browsed is { } browsed ? new[] { browsed } : Array.Empty<CaptureConfigurationOption>())
        .Concat(_scan?.Candidates ?? []).DistinctBy(option => option.Path, StringComparer.OrdinalIgnoreCase).ToArray();
    private IReadOnlyList<CaptureConfigurationOption> FilteredCandidates
    {
        get
        {
            var query = _query.Trim();
            var options = Candidates.Where(option => _filter switch
            {
                "both" => option.IsValid && option.RareBounds is not null,
                "normal" => option.IsValid && option.RareBounds is null,
                "invalid" => !option.IsValid,
                "all" => true,
                _ => option.IsValid,
            }).Where(option => query.Length == 0 || option.Path.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                option.Label.Contains(query, StringComparison.OrdinalIgnoreCase));
            return (_sort switch
            {
                "path" => options.OrderBy(option => option.Path, StringComparer.OrdinalIgnoreCase),
                "recent" => options.OrderByDescending(option => option.LastWriteUtc).ThenBy(option => option.Path, StringComparer.OrdinalIgnoreCase),
                _ => options.OrderByDescending(option => SamePath(_scan?.ActivePath, option.Path))
                    .ThenByDescending(option => option.RareBounds is not null)
                    .ThenByDescending(option => option.LastWriteUtc).ThenBy(option => option.Path, StringComparer.OrdinalIgnoreCase),
            }).ToArray();
        }
    }
    private CaptureConfigurationOption? SelectedOption => Candidates.FirstOrDefault(option => SamePath(option.Path, _selectedPath ?? _scan?.ActivePath));
    private string SelectionLabel => _selectedPath is null ? "Automatische Auswahl" : SelectedOption is { } selected ? CompactLabel(selected) : _selectedPath;
    private static string CompactLabel(CaptureConfigurationOption option)
    {
        var path = option.Label.EndsWith(".xml", StringComparison.OrdinalIgnoreCase) ? option.Label : option.Path;
        var segments = path.Replace('\\', '/').Split('/', StringSplitOptions.RemoveEmptyEntries).SkipLast(1).ToArray();
        if (segments.Length == 0) return System.IO.Path.GetFileName(System.IO.Path.GetDirectoryName(option.Path)) ?? "Konfigurationsdatei";
        var cacheIndex = Array.FindIndex(segments, segment => segment.Equals("UserCache", StringComparison.OrdinalIgnoreCase));
        return string.Join(" / ", cacheIndex >= 0 ? segments.Skip(cacheIndex + 1) : segments.TakeLast(3));
    }
    private static string PositionLabel(System.Drawing.Rectangle bounds) => $"x {bounds.X} · y {bounds.Y}";
    private void SetQuery(string query) => _query = query;
    private void SetFilter(string filter) => _filter = filter;
    private void SetSort(string sort) => _sort = sort;
    private void ResetFilters() { _filter = "usable"; _query = ""; }
    private void ShowSelection() { _filter = "all"; _query = ""; _expandedPath = _selectedPath; }
    private void ToggleDetails(string path) => _expandedPath = SamePath(_expandedPath, path) ? null : path;
    private bool SelectionIsValid => _selectedPath is null || Candidates.Any(option => option.IsValid && SamePath(option.Path, _selectedPath));
    private bool CanApply => _preview is { Error: null, ImageDataUrl: not null, Configuration.IsValid: true } &&
        SamePath(_previewSelectionPath, _selectedPath);
    private static bool SamePath(string? left, string? right) => string.Equals(left, right, StringComparison.OrdinalIgnoreCase);
    private static string ChangedAt(DateTime? utc) => utc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm", German) ?? "Unbekannt";
    private static string BoundsLabel(System.Drawing.Rectangle? bounds) => bounds is { } box
        ? $"x {box.X}, y {box.Y} · {box.Width} × {box.Height} px" : "Nicht verfügbar";

    private async Task ToggleOpen()
    {
        if (Acting) return;
        _open = !_open;
        if (_open) await Scan();
        else { _preview = null; _success = null; ClearActionError(); }
    }

    private async Task Scan()
    {
        if (Busy) return;
        _success = null;
        _preview = null;
        await Act(async () =>
        {
            SetScan(await Tracker.ScanCaptureConfigurationsAsync());
            if (!_selectionInitialized)
            {
                _selectedPath = Tracker.Preferences.CaptureConfigurationPath;
                _selectionInitialized = true;
            }
        });
    }

    private void SetScan(CaptureConfigurationScan scan)
    {
        _scan = scan;
        if (_browsed is not null && scan.Candidates.Any(option => SamePath(option.Path, _browsed.Path))) _browsed = null;
    }

    private void Choose(CaptureConfigurationOption option)
    {
        if (Busy || !option.IsValid) return;
        ChoosePath(option.Path);
    }

    private void ChooseAutomatic()
    {
        if (!Busy) ChoosePath(null);
    }

    private void ChoosePath(string? path)
    {
        _selectedPath = path;
        _expandedPath = null;
        _preview = null;
        _success = null;
        ClearActionError();
    }

    private async Task Browse()
    {
        if (Busy) return;
        await Act(async () =>
        {
            if (await Tracker.BrowseCaptureConfigurationAsync() is not { } option) return;
            _browsed = option;
            _query = "";
            _filter = option.IsValid ? "usable" : "invalid";
            _preview = null;
            _success = null;
            if (option.IsValid) ChoosePath(option.Path);
            else _expandedPath = option.Path;
        });
    }

    private async Task Preview()
    {
        if (Busy || State.IsRunning || !SelectionIsValid) return;
        _success = null;
        _preview = null;
        await Act(async () =>
        {
            _previewSelectionPath = _selectedPath;
            _preview = await Tracker.PreviewCaptureConfigurationAsync(_selectedPath);
        });
    }

    private async Task Apply()
    {
        if (Busy || State.HasSession || State.IsRunning || !CanApply) return;
        _success = null;
        if (await Act(() => Tracker.SelectCaptureConfigurationAsync(_selectedPath)))
        {
            _success = _selectedPath is null ? "Automatische Auswahl gespeichert." : "Dateiauswahl gespeichert.";
            await Act(async () => SetScan(await Tracker.ScanCaptureConfigurationsAsync()));
        }
    }

    public override void Dispose()
    {
        _preview = null;
        base.Dispose();
    }
}
