@inherits TrackerComponentBase

<section class="panel settings-panel capture-configuration" aria-labelledby="capture-configuration-heading">
    <div class="settings-heading capture-configuration-heading">
        <div class="settings-icon"><AppIcon Name="monitor" /></div>
        <div><h2 id="capture-configuration-heading">Erfassungsbereiche prüfen</h2><p>BDO-Einstellungen und die beiden Lootbereiche im Spielbild vergleichen.</p></div>
        <button type="button" class="button secondary" aria-expanded="@(_open ? "true" : "false")" aria-controls="capture-configuration-content" @onclick="ToggleOpen" disabled="@Acting">@(_open ? "Schließen" : "Prüfen")</button>
    </div>
    @if (_open)
    {
        <div id="capture-configuration-content">
            <div class="capture-active-file" role="status">
                <strong>Aktuell verwendete Datei</strong>
                <code>@(_scan?.ActivePath ?? "Noch keine passende Datei ermittelt.")</code>
                <span>@(Tracker.Preferences.CaptureConfigurationPath is null ? "Automatische Auswahl" : "Fest ausgewählte Datei")</span>
            </div>
            @if (ActionError is not null) { <div class="notice error-notice" role="alert">@ActionError</div> }
            @if (_scan?.Error is { } scanError) { <div class="notice error-notice" role="alert">@scanError</div> }
            @if (_success is not null) { <div class="notice success-notice" role="status">@_success</div> }
            <div class="capture-actions">
                <button type="button" class="button secondary" @onclick="Scan" disabled="@Busy"><AppIcon Name="refresh" />Dateien erneut suchen</button>
                <button type="button" class="button secondary" @onclick="Browse" disabled="@Busy">Datei auswählen…</button>
            </div>
            <p class="field-note">Für die Vorschau markieren. Erst „Verwenden“ übernimmt die Auswahl.</p>
            <label class="capture-option capture-automatic">
                <input type="radio" name="capture-configuration-choice" checked="@(_selectedPath is null)" @onchange="ChooseAutomatic" disabled="@Busy" />
                <span><strong>Automatische Auswahl</strong><small>Verwendet das zuletzt gespeicherte Profil.</small></span>
            </label>
            <p class="field-note">Verfügbare Dateien: @Candidates.Count</p>
            <div class="capture-options" aria-label="Verfügbare BDO-Einstellungsdateien">
                @foreach (var option in Candidates)
                {
                    <article class="capture-option @(SamePath(_selectedPath, option.Path) ? "is-selected" : string.Empty)" @key="option.Path">
                        <label class="capture-option-choice">
                            <input type="radio" name="capture-configuration-choice" checked="@SamePath(_selectedPath, option.Path)" @onchange="() => Choose(option)" disabled="@(Busy || !option.IsValid)" />
                            <span><strong>@option.Label</strong><code>@option.Path</code></span>
                            @if (SamePath(_scan?.ActivePath, option.Path)) { <span class="capture-active-badge">Aktiv</span> }
                        </label>
                        <dl class="capture-option-details">
                            <div><dt>Geändert</dt><dd>@ChangedAt(option.LastWriteUtc)</dd></div>
                            <div><dt>Auflösung</dt><dd>@(option.ScreenWidth > 0 && option.ScreenHeight > 0 ? $"{option.ScreenWidth} × {option.ScreenHeight}" : "Unbekannt")</dd></div>
                            <div><dt>UI-Skalierung</dt><dd>@(option.UiScale > 0 ? option.UiScale.ToString("P0", German) : "Unbekannt")</dd></div>
                            <div><dt>Normales Droplog</dt><dd>@BoundsLabel(option.NormalBounds)</dd></div>
                            <div><dt>Special-Droplog</dt><dd>@BoundsLabel(option.RareBounds)</dd></div>
                        </dl>
                        <p class="field-note">Special-Droplog: @option.RareStatus</p>
                        @if (option.Error is { } error) { <p class="field-error" role="alert">Nicht verwendbar: @error</p> }
                    </article>
                }
            </div>
            @if (_scan is not null && Candidates.Count == 0) { <p class="field-note">Keine BDO-Einstellungsdatei gefunden. Du kannst eine Datei selbst auswählen.</p> }
            @if (State.IsRunning) { <p class="field-note">Für ein Vorschaubild zuerst die laufende Erfassung pausieren.</p> }
            @if (State.HasSession) { <p class="field-note">Die Dateiauswahl lässt sich vor dem Start einer neuen Session übernehmen.</p> }
            <p class="field-note">Ist die Special-Zeile verborgen, im BDO-Modus „UI bearbeiten“ die Lootanzeigen sichtbar machen.</p>
            <div class="capture-actions">
                <button type="button" class="button secondary" @onclick="Preview" disabled="@(Busy || State.IsRunning || !SelectionIsValid)"><AppIcon Name="refresh" />Vorschau aktualisieren</button>
                <button type="button" class="button primary" @onclick="Apply" disabled="@(Busy || State.HasSession || State.IsRunning || !CanApply)">@(_selectedPath is null ? "Automatische Auswahl verwenden" : "Verwenden")</button>
            </div>
            @if (Acting) { <p class="field-note" role="status">Wird geprüft…</p> }
            @if (_preview?.Error is { } previewError) { <div class="notice error-notice" role="alert">@previewError</div> }
            @if (_preview is { ImageDataUrl: not null, Configuration: { } configuration } preview)
            {
                <div class="capture-preview">
                    <div class="capture-preview-heading"><h3>Vorschaubild</h3><span>@(preview.CapturedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss", German) ?? "Zeitpunkt unbekannt")</span></div>
                    <code>@configuration.Path</code>
                    @if (preview.UsesSessionGeometry) { <p class="field-note">Erfassungsbereiche der pausierten Session. Eine geänderte Datei lässt sich für eine neue Session übernehmen.</p> }
                    <p class="field-note">Einzelaufnahme. Zum Vergleichen die Lootanzeigen im Spiel einblenden und die Vorschau aktualisieren.</p>
                    <div class="capture-legend"><span class="capture-normal-color">Türkis: normales Droplog</span><span class="capture-rare-color">Gold: Special-Droplog</span></div>
                    <svg class="capture-full-image" viewBox="@($"0 0 {configuration.ScreenWidth} {configuration.ScreenHeight}")" role="img" aria-label="Spielbild mit markierten Erfassungsbereichen">
                        <image href="@preview.ImageDataUrl" x="0" y="0" width="@configuration.ScreenWidth" height="@configuration.ScreenHeight" />
                        @if (configuration.NormalBounds is { } normal)
                        {
                            <rect class="capture-normal-rect" x="@normal.X" y="@normal.Y" width="@normal.Width" height="@normal.Height" fill="none" stroke="#72cbb7" stroke-width="3" vector-effect="non-scaling-stroke"><title>Normales Droplog: @BoundsLabel(normal)</title></rect>
                        }
                        @if (configuration.RareBounds is { } rare)
                        {
                            <rect class="capture-rare-rect" x="@rare.X" y="@rare.Y" width="@rare.Width" height="@rare.Height" fill="none" stroke="#efce91" stroke-width="3" vector-effect="non-scaling-stroke"><title>Special-Droplog: @BoundsLabel(rare)</title></rect>
                        }
                    </svg>
                    <div class="capture-crops">
                        @if (preview.NormalImageDataUrl is { } normalImage)
                        {
                            <figure class="capture-normal-crop"><figcaption>Normales Droplog</figcaption><div><img src="@normalImage" alt="Genauer Bildausschnitt des normalen Droplogs" /></div></figure>
                        }
                        @if (preview.RareImageDataUrl is { } rareImage)
                        {
                            <figure class="capture-rare-crop"><figcaption>Special-Droplog</figcaption><div><img src="@rareImage" alt="Genauer Bildausschnitt des Special-Droplogs" /></div></figure>
                        }
                        else { <p class="field-note">Special-Droplog: @configuration.RareStatus</p> }
                    </div>
                </div>
            }
        </div>
    }
</section>

<style>
    .capture-configuration{margin-top:20px}.capture-configuration-heading{align-items:center;flex-wrap:wrap}.capture-configuration-heading>div:nth-child(2){flex:1;min-width:220px}.capture-configuration-heading p{font-size:13px;margin-top:5px}.capture-configuration code{display:block;overflow-wrap:anywhere;white-space:normal;font-size:12px;line-height:1.6;color:var(--muted)}.capture-active-file{display:grid;gap:6px;padding:14px 16px;margin-bottom:16px;background:#11171d;border:1px solid var(--line);border-radius:8px}.capture-active-file>span{color:var(--gold);font-size:13px}.capture-actions{display:flex;gap:10px;flex-wrap:wrap;margin:16px 0}.capture-options{max-height:440px;overflow-y:auto;overscroll-behavior:contain;padding-right:4px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:12px;margin:12px 0}.capture-option{display:block;border:1px solid var(--line);background:#151a21;border-radius:8px;padding:15px}.capture-option.is-selected{border-color:var(--gold)}.capture-option-choice,.capture-automatic{display:flex;align-items:flex-start;gap:10px}.capture-option-choice>span:first-of-type{flex:1;min-width:0}.capture-option input{flex-shrink:0;accent-color:var(--gold);margin:4px 0}.capture-automatic small{display:block;margin-top:4px;color:var(--muted)}.capture-option-details{display:flex;gap:12px 24px;flex-wrap:wrap;margin:14px 0 8px}.capture-option-details dt{font-size:12px;color:var(--muted)}.capture-option-details dd{margin:3px 0 0;font-size:13px;font-variant-numeric:tabular-nums}.capture-active-badge{font-size:12px;color:var(--teal);border:1px solid #72cbb755;border-radius:4px;padding:2px 6px}.capture-preview{border-top:1px solid var(--line);padding-top:20px;margin-top:20px}.capture-preview-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:8px}.capture-preview-heading>span{font-size:13px;color:var(--muted)}.capture-legend{display:flex;flex-wrap:wrap;gap:16px;margin:14px 0;font-size:13px}.capture-normal-color,.capture-normal-crop figcaption{color:var(--teal)}.capture-rare-color,.capture-rare-crop figcaption{color:var(--gold-bright)}.capture-full-image{display:block;width:100%;height:auto;background:#080b0f;border:1px solid var(--line);border-radius:7px}.capture-crops{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:20px;margin-top:20px}.capture-crops figure{margin:0;min-width:0}.capture-crops figcaption{font-weight:600;margin-bottom:9px}.capture-crops figure>div{overflow:auto;border:1px solid var(--line);background:#080b0f;padding:8px;border-radius:6px}.capture-crops img{display:block;max-width:100%;height:auto}
</style>

@code {
    private bool _open, _selectionInitialized;
    private string? _selectedPath, _previewSelectionPath, _success;
    private CaptureConfigurationScan? _scan;
    private CaptureConfigurationOption? _browsed;
    private CaptureConfigurationPreview? _preview;
    private bool Busy => Acting || State.IsBusy;
    private IReadOnlyList<CaptureConfigurationOption> Candidates => (_browsed is { } browsed ? new[] { browsed } : Array.Empty<CaptureConfigurationOption>())
        .Concat(_scan?.Candidates ?? []).DistinctBy(option => option.Path, StringComparer.OrdinalIgnoreCase).ToArray();
    private bool SelectionIsValid => _selectedPath is null || Candidates.Any(option => option.IsValid && SamePath(option.Path, _selectedPath));
    private bool CanApply => _preview is { Error: null, ImageDataUrl: not null, Configuration.IsValid: true } &&
        SamePath(_previewSelectionPath, _selectedPath);
    private static bool SamePath(string? left, string? right) => string.Equals(left, right, StringComparison.OrdinalIgnoreCase);
    private static string ChangedAt(DateTime? utc) => utc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm", German) ?? "Unbekannt";
    private static string BoundsLabel(System.Drawing.Rectangle? bounds) => bounds is { } box
        ? $"x {box.X}, y {box.Y} · {box.Width} × {box.Height} px" : "Nicht verfügbar";

    private async Task ToggleOpen()
    {
        if (Acting) return;
        _open = !_open;
        if (_open) await Scan();
        else { _preview = null; _success = null; ClearActionError(); }
    }

    private async Task Scan()
    {
        if (Busy) return;
        _success = null;
        _preview = null;
        await Act(async () =>
        {
            SetScan(await Tracker.ScanCaptureConfigurationsAsync());
            if (!_selectionInitialized)
            {
                _selectedPath = Tracker.Preferences.CaptureConfigurationPath;
                _selectionInitialized = true;
            }
        });
    }

    private void SetScan(CaptureConfigurationScan scan)
    {
        _scan = scan;
        if (_browsed is not null && scan.Candidates.Any(option => SamePath(option.Path, _browsed.Path))) _browsed = null;
    }

    private void Choose(CaptureConfigurationOption option)
    {
        if (Busy || !option.IsValid) return;
        ChoosePath(option.Path);
    }

    private void ChooseAutomatic()
    {
        if (!Busy) ChoosePath(null);
    }

    private void ChoosePath(string? path)
    {
        _selectedPath = path;
        _preview = null;
        _success = null;
        ClearActionError();
    }

    private async Task Browse()
    {
        if (Busy) return;
        await Act(async () =>
        {
            if (await Tracker.BrowseCaptureConfigurationAsync() is not { } option) return;
            _browsed = option;
            if (option.IsValid) ChoosePath(option.Path);
        });
    }

    private async Task Preview()
    {
        if (Busy || State.IsRunning || !SelectionIsValid) return;
        _success = null;
        _preview = null;
        await Act(async () =>
        {
            _previewSelectionPath = _selectedPath;
            _preview = await Tracker.PreviewCaptureConfigurationAsync(_selectedPath);
        });
    }

    private async Task Apply()
    {
        if (Busy || State.HasSession || State.IsRunning || !CanApply) return;
        _success = null;
        if (await Act(() => Tracker.SelectCaptureConfigurationAsync(_selectedPath)))
        {
            _success = _selectedPath is null ? "Automatische Auswahl gespeichert." : "Dateiauswahl gespeichert.";
            await Act(async () => SetScan(await Tracker.ScanCaptureConfigurationsAsync()));
        }
    }

    public override void Dispose()
    {
        _preview = null;
        base.Dispose();
    }
}
