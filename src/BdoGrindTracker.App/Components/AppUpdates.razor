@inherits TrackerComponentBase
@using BdoGrindTracker.App.Updates
@inject IAppUpdates Updates
@inject NavigationManager Navigation

@if (Compact)
{
    @if (Update.UsesStore && Update.Enabled && Update.Phase is UpdatePhase.Available or UpdatePhase.Downloading or UpdatePhase.ReadyToRestart or UpdatePhase.Installed or UpdatePhase.Restarting)
    {
        <div class="update-banner" role="status">
            <AppIcon Name="refresh" />
            <span>@(Update.Phase == UpdatePhase.Available && Update.AvailableVersion is { Length: > 0 } availableVersion ? F("Version {0} ist verfügbar.", availableVersion) : T(Update.Message))</span>
            <button type="button" class="button secondary" @onclick="ViewUpdate">@T("Update ansehen")</button>
        </div>
    }
}
else
{
    <section class="panel settings-panel update-panel" aria-labelledby="updates-heading">
        <div class="settings-heading"><div class="settings-icon gold-icon"><AppIcon Name="refresh" /></div><div><h2 id="updates-heading">@T("App-Updates")</h2><p>Grindcrest @AppBranding.Version</p></div></div>
        <p class="update-message" role="status" aria-live="polite">@(Update.Phase == UpdatePhase.Available && Update.AvailableVersion is { Length: > 0 } availableVersion ? F("Version {0} ist verfügbar.", availableVersion) : T(Update.Message))</p>
        @if (Update.Phase == UpdatePhase.Downloading || Update.UsesStore && Update.Phase == UpdatePhase.Restarting)
        {
            <UpdateProgress IsIndeterminate="Update.IsDownloadIndeterminate" DownloadPercent="Update.DownloadPercent"
                            DownloadedBytes="Update.DownloadedBytes" TotalDownloadBytes="Update.TotalDownloadBytes"
                            OperationStartedAt="Update.OperationStartedAt" Language="@UiLanguage" />
        }
        @if (Update.Phase == UpdatePhase.StoreManaged)
        {
            <p class="field-note">@T("Updates im Microsoft Store suchen.")</p>
        }
        else
        {
            <div class="update-actions">
                <button type="button" class="button secondary" @onclick="Updates.CheckAsync" disabled="@(!Update.Enabled || Update.IsBusy || Update.Phase is UpdatePhase.ReadyToRestart or UpdatePhase.Installed)"><AppIcon Name="refresh" />@T("Nach Updates suchen")</button>
                @if (Update.UsesStore && Update.Enabled && Update.Phase == UpdatePhase.Available)
                {
                    <button type="button" class="button primary" @onclick="InstallStoreUpdate" disabled="@(State.IsRunning || State.IsBusy || Acting)">@T("Jetzt aktualisieren")</button>
                }
                @if (Update.UsesStore && Update.Enabled && Update.Phase == UpdatePhase.ReadyToRestart)
                {
                    <button type="button" class="button primary" @onclick="InstallStoreUpdate" disabled="@(State.IsRunning || State.IsBusy || Acting)">@T("Update installieren")</button>
                }
            </div>
        }
        @if (Update.UsesStore && Update.Enabled && Update.Phase is UpdatePhase.Available or UpdatePhase.ReadyToRestart)
        {
            <div class="subtle-box"><AppIcon Name="shield" /><span>@(State.IsRunning ? T("Session zuerst pausieren, um das Update zu installieren.") : State.IsBusy ? T("Warte, bis der aktuelle Vorgang abgeschlossen ist.") : T("Windows kann Grindcrest für die Installation schließen."))</span></div>
        }
        @if (ActionError is not null) { <div class="notice error-notice" role="alert">@T(ActionError)</div> }
    </section>
}

@code {
    [Parameter] public bool Compact { get; set; }
    [CascadingParameter(Name = "ShowStoreUpdateDialog")] public EventCallback ShowStoreUpdateDialog { get; set; }
    private UpdateState Update => Updates.State;
    private bool _disposed;
    protected override void OnInitialized()
    {
        base.OnInitialized();
        Updates.Changed += UpdateChanged;
    }
    private void UpdateChanged()
    {
        if (!_disposed) _ = InvokeAsync(() => { if (!_disposed) StateHasChanged(); });
    }
    private Task ViewUpdate()
    {
        if (Update.UsesStore && ShowStoreUpdateDialog.HasDelegate) return ShowStoreUpdateDialog.InvokeAsync();
        Navigation.NavigateTo("/settings/updates");
        return Task.CompletedTask;
    }
    private async Task InstallStoreUpdate()
    {
        if (!Update.UsesStore || !Update.Enabled || Update.Phase is not (UpdatePhase.Available or UpdatePhase.ReadyToRestart) || State.IsRunning || State.IsBusy) return;
        await Act(Updates.RequestRestartAsync);
    }
    public override void Dispose()
    {
        _disposed = true;
        Updates.Changed -= UpdateChanged;
        base.Dispose();
    }
}
