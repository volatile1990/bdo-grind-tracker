@inherits TrackerComponentBase
@using BdoGrindTracker.App.Updates
@inject IAppUpdates Updates
@inject NavigationManager Navigation

@if (Compact)
{
    @if (Update.Phase is UpdatePhase.Available or UpdatePhase.Downloading or UpdatePhase.ReadyToRestart or UpdatePhase.Installed || Update.UsesStore && Update.Phase == UpdatePhase.Restarting)
    {
        <div class="update-banner" role="status">
            <AppIcon Name="refresh" />
            <span>@Update.Message</span>
            <button type="button" class="button secondary" @onclick="ViewUpdate">Update ansehen</button>
        </div>
    }
}
else
{
    <section class="panel settings-panel update-panel" aria-labelledby="updates-heading">
        <div class="settings-heading"><div class="settings-icon gold-icon"><AppIcon Name="refresh" /></div><div><h2 id="updates-heading">App-Updates</h2><p>Grindcrest @AppBranding.Version</p></div></div>
        <p class="update-message" role="status" aria-live="polite">@Update.Message</p>
        @if (Update.Phase == UpdatePhase.Downloading || Update.UsesStore && Update.Phase == UpdatePhase.Restarting)
        {
            <div class="update-progress"><progress max="100" value="@Update.DownloadPercent" aria-label="@(Update.Phase == UpdatePhase.Restarting ? "Update installieren" : "Update herunterladen")"></progress><span>@Update.DownloadPercent %</span></div>
        }
        @if (Update.Phase == UpdatePhase.StoreManaged)
        {
            <p class="field-note">Updates im Microsoft Store suchen.</p>
        }
        else
        {
            <div class="update-actions">
                <button type="button" class="button secondary" @onclick="Updates.CheckAsync" disabled="@(!Update.Enabled || Update.IsBusy || Update.Phase is UpdatePhase.ReadyToRestart or UpdatePhase.Installed)"><AppIcon Name="refresh" />Nach Updates suchen</button>
                @if (Update.UsesStore && Update.Enabled && Update.Phase == UpdatePhase.Available)
                {
                    <button type="button" class="button primary" @onclick="InstallStoreUpdate" disabled="@(State.IsRunning || State.IsBusy || Acting)">Jetzt aktualisieren</button>
                }
                @if (!Update.UsesStore && Update.CanDownload)
                {
                    <button type="button" class="button primary" @onclick="Updates.DownloadAsync">Update herunterladen</button>
                }
                @if (Update.Phase == UpdatePhase.ReadyToRestart)
                {
                    <button type="button" class="button primary" @onclick="InstallReadyUpdate" disabled="@(State.IsRunning || State.IsBusy || Acting)">@(Update.UsesStore ? "Update installieren" : "Installieren und neu starten")</button>
                }
            </div>
        }
        @if (Update.Enabled)
        {
            @if ((Update.Phase == UpdatePhase.ReadyToRestart || Update.UsesStore && Update.Phase == UpdatePhase.Available) && (State.IsRunning || State.IsBusy || Update.UsesStore))
            {
                <div class="subtle-box"><AppIcon Name="shield" /><span>@(State.IsRunning ? "Session zuerst pausieren, um das Update zu installieren." : State.IsBusy ? "Warte, bis der aktuelle Vorgang abgeschlossen ist." : "Windows kann Grindcrest für die Installation schließen.")</span></div>
            }
            @if (!Update.UsesStore)
            {
                <label class="toggle-row"><span><strong>Beta-Updates erhalten</strong><small>Nach dem Ausschalten erhältst du die nächste höhere stabile Version.</small></span><input type="checkbox" class="switch" checked="@Update.IsBeta" @onchange="ChangeBeta" disabled="@Update.IsBusy" /></label>
            }
        }
        @if (ActionError is not null) { <div class="notice error-notice" role="alert">@ActionError</div> }
    </section>
}

@code {
    [Parameter] public bool Compact { get; set; }
    [CascadingParameter(Name = "ShowStoreUpdateDialog")] public EventCallback ShowStoreUpdateDialog { get; set; }
    private UpdateState Update => Updates.State;
    private bool _disposed;
    protected override void OnInitialized()
    {
        base.OnInitialized();
        Updates.Changed += UpdateChanged;
    }
    private void UpdateChanged()
    {
        if (!_disposed) _ = InvokeAsync(() => { if (!_disposed) StateHasChanged(); });
    }
    private Task ViewUpdate()
    {
        if (Update.UsesStore && ShowStoreUpdateDialog.HasDelegate) return ShowStoreUpdateDialog.InvokeAsync();
        Navigation.NavigateTo("/settings");
        return Task.CompletedTask;
    }
    private async Task InstallStoreUpdate()
    {
        if (!Update.UsesStore || !Update.Enabled || Update.Phase is not (UpdatePhase.Available or UpdatePhase.ReadyToRestart) || State.IsRunning || State.IsBusy) return;
        await Act(Updates.RequestRestartAsync);
    }
    private Task InstallReadyUpdate() => Update.UsesStore ? InstallStoreUpdate() : Updates.RequestRestartAsync();
    private Task ChangeBeta(ChangeEventArgs args) => Updates.SetBetaAsync(args.Value is true);
    public override void Dispose()
    {
        _disposed = true;
        Updates.Changed -= UpdateChanged;
        base.Dispose();
    }
}
