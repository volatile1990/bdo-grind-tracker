@inherits TrackerComponentBase
@inject IJSRuntime JS

<div class="page live-page">
    <div class="page-heading">
        <div><span class="eyebrow">DEIN GRIND, IM BLICK</span><h1>Live-Session</h1><p>Konzentrier dich aufs Abenteuer. Wir behalten den Loot im Blick.</p></div>
        <div class="page-actions">
            <button class="button secondary" @onclick="RequestNew" disabled="@(Acting || State.IsBusy)"><AppIcon Name="plus" />Neue Session</button>
            <button class="button primary" @onclick="() => Act(Tracker.ToggleTrackingAsync)" disabled="@(Acting || State.IsBusy || State.IsSubmitted || (!State.IsRunning && !State.AnalyzerAvailable))" title="@(State.IsSubmitted ? "Diese Session ist abgeschlossen. Beginne eine neue Session." : null)"><AppIcon Name="@(State.IsRunning ? "pause" : "play")" />@(State.IsRunning ? "Pausieren" : State.HasSession ? "Fortsetzen" : "Tracking starten")</button>
        </div>
    </div>

    @if (State.IsDemo)
    {
        <div class="notice demo-notice"><AppIcon Name="spark" /><div><strong>Du erkundest die Demo</strong><span>Beispieldaten werden weder im Verlauf gespeichert noch hochgeladen.</span></div><button class="text-button" @onclick="() => Act(() => Tracker.SetDemoAsync(false))" disabled="@Acting">Demo beenden <AppIcon Name="close" /></button></div>
    }
    @if (ActionError is not null) { <div class="notice error-notice" role="alert"><AppIcon Name="info" />@ActionError</div> }
    @if (State.IsSubmitted) { <div class="notice"><AppIcon Name="info" /><div><strong>Session abgeschlossen</strong><span>Diese Session lässt sich nicht weiterführen oder erneut übertragen. Beginne für deinen nächsten Grind eine neue Session.</span></div></div> }
    @if (!State.AnalyzerAvailable && !State.IsDemo) { <div class="notice warning-notice"><AppIcon Name="info" /><div><strong>Erfassung noch nicht verfügbar</strong><span>@State.Status</span></div><button class="text-button" @onclick="OnSettings">Einstellungen <AppIcon Name="arrow" /></button></div> }

    <section class="spot-hero" style="@HeroStyle" aria-label="Aktueller Grindspot">
        <div class="hero-shade"></div>
        <div class="hero-content">
            <div class="hero-kicker"><span class="status-dot @(State.IsRunning ? "running" : "")"></span>@(State.SpotId is null ? "AUTOMATISCHE SPOTERKENNUNG" : "INNER EDANIA")</div>
            <div class="hero-identity">
                @if (CurrentProfile is { } profile) { <AssetImage Src="@("assets/spot-icons/" + profile.IconFileName)" Alt="" Class="spot-emblem" Fallback="pin" /> }
                <div><h2>@(State.SpotId is null ? "Dein Abenteuer beginnt hier." : SpotName(State.SpotId))</h2><p>@(State.SpotId is null ? "Der erste eindeutige Drop erkennt deinen Grindspot automatisch." : CurrentProfile?.TrashItemName)</p></div>
            </div>
            <div class="hero-bottom"><span class="character-chip"><AssetImage Src="@ClassIcon(State.CharacterClassId)" Alt="" Class="class-image" Fallback="shield" />@State.CharacterLabel</span><span class="hero-divider"></span><span><AppIcon Name="monitor" />@MonitorLabel</span></div>
        </div>
        <div class="hero-badge"><span class="status-dot @(State.IsRunning ? "running" : "")"></span>@(State.IsDemo ? "Vorschau" : State.IsRunning ? "Live" : State.HasSession ? "Pausiert" : "Bereit für den Grind")</div>
    </section>

    <div class="metrics-grid" aria-label="Session-Kennzahlen">
        <article class="metric-card"><div class="metric-label"><span>AKTIVE ZEIT</span><AppIcon Name="clock" /></div><strong class="metric-value time-value">@Duration(State.Elapsed)</strong><span class="metric-note">@(State.IsDemo ? "Beispielsession · 1 Stunde" : State.IsRunning ? "Deine Session läuft" : State.HasSession ? "Pause wird nicht mitgezählt" : "Beginnt mit dem ersten Loot")</span></article>
        <article class="metric-card"><div class="metric-label"><span>TRASHLOOT</span><AppIcon Name="loot" /></div><strong class="metric-value">@Number(Trash(State.Loot.Totals, State.SpotId))</strong><span class="metric-note"><span class="teal">@Number(Hourly(Trash(State.Loot.Totals, State.SpotId), State.Elapsed))</span> pro Stunde</span></article>
        <article class="metric-card gold-metric"><div class="metric-label"><span>SILBER NETTO</span><AppIcon Name="silver" /></div><strong class="metric-value">@(CanShowSilver ? Silver(State.Silver.AfterTax) : "—")@if (!State.Silver.IsComplete) { <span class="estimate-mark" title="Bekannter Teilbetrag. Es fehlen Gegenstandspreise."> *</span> }</strong><span class="metric-note">@ValuationLabel</span></article>
        <article class="metric-card"><div class="metric-label"><span>SILBER / STUNDE</span><AppIcon Name="trend" /></div><strong class="metric-value">@(State.Elapsed > TimeSpan.Zero && CanShowSilver ? Silver(Hourly(State.Silver.AfterTax, State.Elapsed)) : "—")@if (!State.Silver.IsComplete && State.Elapsed > TimeSpan.Zero) { <span class="estimate-mark"> *</span> }</strong><span class="metric-note">Ø über deine aktive Grindzeit</span></article>
    </div>
    @if (!State.Silver.IsComplete || State.Silver.IsStale)
    {
        <div class="valuation-note"><AppIcon Name="info" /><span>@(!State.Silver.IsComplete ? "* Teilbetrag: " + string.Join(", ", State.Silver.MissingItems.Concat(State.Silver.OverflowItems)) + " noch ohne verlässlichen Preis. " : "")@(State.Silver.IsStale ? "Einige Marktwerte stammen aus dem Cache." : "")</span></div>
    }

    <div class="live-content-grid">
        <LootTable Totals="State.Loot.Totals" DurationTicks="State.Elapsed.Ticks" TrashName="CurrentProfile?.TrashItemName" />
        <div class="session-aside">
            <section class="panel session-summary"><div class="panel-heading"><h2>Session-Details</h2><AppIcon Name="live" /></div><dl class="detail-list"><div><dt>Bestätigte Drops</dt><dd>@Number(State.Loot.ConfirmedEventCount)</dd></div><div><dt>Verschiedene Items</dt><dd>@State.Loot.ItemTypeCount</dd></div><div><dt>Bruttowert</dt><dd>@(CanShowSilver ? Silver(State.Silver.BeforeTax) : "—")@(!State.Silver.IsComplete ? " *" : "")</dd></div><div><dt>Markterlös</dt><dd>@Tracker.Preferences.Tax.MarketReturnRate.ToString("P2", German)</dd></div><div><dt>Automatische Pause</dt><dd>@Tracker.Preferences.AutoPauseMinutes Min.</dd></div></dl><div class="subtle-box"><AppIcon Name="shield" /><span>Die automatische Pause greift, wenn kein neuer Loot erkannt wird.</span></div></section>
            <section class="panel garmoth-panel"><div class="panel-heading"><h2>Garmoth</h2><span class="badge @(Tracker.Preferences.AutoUpload ? "teal-badge" : "muted-badge")">@(Tracker.Preferences.AutoUpload ? "Auto-Upload an" : "Manuell")</span></div><p>@UploadDescription</p><button class="button secondary full-width" @onclick="RequestUpload" disabled="@(!CanUpload)"><AppIcon Name="upload" />@(State.IsSubmitted ? "Session abgeschlossen" : "Session hochladen")</button>@if (!State.HasApiKey) { <button class="text-button centered" @onclick="OnSettings">API-Schlüssel hinterlegen <AppIcon Name="arrow" /></button> }</section>
            <div class="price-status"><span class="status-dot @(State.Silver.IsStale ? "" : "running")"></span><span>@State.PriceStatus</span><button class="icon-button" title="Marktpreise aktualisieren" aria-label="Marktpreise aktualisieren" @onclick="() => Act(Tracker.RefreshPricesAsync)" disabled="@(State.IsBusy || Acting)"><AppIcon Name="refresh" /></button></div>
        </div>
    </div>
    @if (!State.IsDemo && !State.HasSession)
    {
        <div class="demo-invitation"><span>Noch nicht im Spiel? Lerne die Oberfläche mit einer Beispielsession kennen.</span><button class="text-button" @onclick="() => Act(() => Tracker.SetDemoAsync(true))" disabled="@(Acting || State.IsBusy)"><AppIcon Name="spark" />Demo ansehen</button></div>
    }
</div>

<dialog id="live-confirm" class="modal confirm-modal" @oncancel="CloseConfirmation">
    <div class="modal-heading"><div><span class="eyebrow">@(_confirm == "upload" ? "GARMOTH" : "SESSION")</span><h2>@(_confirm == "upload" ? "Session hochladen?" : "Neue Session beginnen?")</h2></div><button class="icon-button" @onclick="CloseConfirmation" aria-label="Dialog schließen"><AppIcon Name="close" /></button></div>
    <p>@(_confirm == "upload" ? "Die aktuelle Session wird pausiert. An Garmoth geht ausschließlich der noch nicht übertragene Anteil – bereits hochgeladene Zeit und Lootmengen werden abgezogen. Die Zusammenfassung zeigt die gesamte Session." : "Die aktuelle Session wird beendet und im Verlauf gesichert. Für die neue Session beginnen Zeit und Loot wieder bei null.")</p>
    @if (_confirm == "upload") { <div class="confirm-summary"><span class="eyebrow">GESAMTE SESSION</span><strong>@SpotName(State.SpotId)</strong><span>@Duration(State.Elapsed) · @Number(Trash(State.Loot.Totals, State.SpotId)) Trashloot</span></div> }
    <div class="modal-actions"><button class="button secondary" @onclick="CloseConfirmation">Abbrechen</button><button class="button primary" @onclick="ConfirmAction" disabled="@Acting">@(_confirm == "upload" ? "Jetzt hochladen" : "Neue Session")</button></div>
</dialog>

@code {
    [Parameter] public EventCallback OnSettings { get; set; }
    private string? _confirm;
    private LootSpotPresentation? CurrentProfile => Profile(State.SpotId);
    private bool CanShowSilver => State.Loot.Totals.Count == 0 || State.Silver.HasKnownValue;
    private string HeroStyle => $"background-image:url('assets/spot-backgrounds/{CurrentProfile?.BackgroundFileName ?? "aphrodon.jpg"}')";
    private string MonitorLabel => Tracker.Monitors.FirstOrDefault(monitor => monitor.DeviceName == Tracker.Preferences.MonitorDeviceName)?.Label ?? Tracker.Monitors.FirstOrDefault()?.Label ?? "Kein Bildschirm";
    private string ValuationLabel => !State.Silver.IsComplete ? "Bekannter Teilbetrag · Preise fehlen" : State.Silver.IsStale ? "Mit gespeicherten Marktpreisen" : "Nach deinen Marktsteuern";
    private bool CanUpload => !Acting && !State.IsBusy && State.HasApiKey && State.HasSession && !State.IsDemo && !State.IsSubmitted && !State.UploadBlocked && State.SpotId is not null && State.Elapsed > TimeSpan.Zero && State.Loot.Totals.Count > 0;
    private string UploadDescription => State.UploadBlocked ? "Diese Session ist gegen eine erneute Übertragung gesperrt. So entstehen keine doppelten Einträge." : State.AutomaticSuspended ? "Der automatische Upload ist für diese Session ausgesetzt. Beachte die Statusmeldung unten." : Tracker.Preferences.AutoUpload ? "Nach jeder aktiven Grindstunde wird nur der neue Stundenanteil übertragen." : "Übertrage deine Session mit einem Klick in deinen Garmoth-Verlauf.";
    private async Task RequestNew()
    {
        if (!State.HasSession && !State.IsDemo) { await Act(Tracker.NewSessionAsync); return; }
        _confirm = "new"; await JS.InvokeVoidAsync("grindcrest.showDialog", "live-confirm");
    }
    private async Task RequestUpload() { _confirm = "upload"; await JS.InvokeVoidAsync("grindcrest.showDialog", "live-confirm"); }
    private async Task CloseConfirmation() { _confirm = null; await JS.InvokeVoidAsync("grindcrest.closeDialog", "live-confirm"); }
    private async Task ConfirmAction()
    {
        var action = _confirm; await CloseConfirmation();
        if (action == "upload") await Act(Tracker.UploadAsync);
        else await Act(async () => { if (State.IsRunning) await Tracker.PauseAsync(); if (!State.IsError) await Tracker.NewSessionAsync(); });
    }
}
