@page "/"
@page "/live"
@inherits TrackerComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="page live-page">
    @if (!Tracker.Preferences.SetupCompleted)
    {
        <div class="notice"><AppIcon Name="info" /><div><strong>@T("Einführung & Einrichtung")</strong><span>@T("Noch neu hier? Richte die Erfassung ein und lerne die wichtigsten Schritte kennen.")</span></div><a class="button secondary" href="setup">@T("Einrichtung fortsetzen")</a></div>
    }
    <section class="live-session-header" style="@HeroStyle" aria-labelledby="live-session-title">
        <div class="live-header-main">
            <div class="live-session-context">
                <div class="sr-only">
                    <h1 id="live-session-title">@T("Live-Session")</h1>
                    <span class="live-session-status"><span class="status-dot @(State.IsError ? "error" : State.IsRunning ? "running" : "")"></span>@SessionStatus</span>
                </div>
                <div class="live-spot-identity">
                    @if (CurrentProfile is { } profile) { <AssetImage Src="@("assets/spot-icons/" + profile.IconFileName)" Alt="" Class="spot-emblem" Fallback="pin" /> }
                    <div class="live-spot-copy">
                        <h2>@(State.SpotId is null ? T("Spot wird automatisch erkannt") : SpotName(State.SpotId))</h2>
                        @if (!State.IsDemo && ShowSpotVariantSelection)
                        {
                            var variantSessionId = State.SessionId;
                            <div class="live-spot-variant">
                                <label for="live-spot-variant">@(State.SpotId == "winter-tree-fossil-unspecified" ? T("AP-Variante bestätigen") : T("Spot-Variante"))</label>
                                <select id="live-spot-variant" value="@State.SpotId" @onchange="args => SelectSpotVariant(variantSessionId, args)" disabled="@(Acting || !State.CanSelectSpotVariant)" aria-describedby="live-spot-variant-help">
                                    @if (!SpotVariants.Any(variant => variant.Id == State.SpotId)) { <option value="@State.SpotId" disabled>@T("Bitte auswählen")</option> }
                                    @foreach (var variant in SpotVariants) { <option value="@variant.Id">@SpotName(variant.Id)</option> }
                                </select>
                                <small id="live-spot-variant-help">@(State.IsSubmitted || !State.CanSelectSpotVariant && !State.IsBusy ? T("Die Spot-Auswahl ist für diese Session abgeschlossen.") : State.SpotId == "winter-tree-fossil-unspecified" ? T("Bitte bestätigen, dass du an der 280-AP-Variante grindest.") : T("Diese Varianten teilen denselben Trashloot. Bitte deinen Spot auswählen."))</small>
                            </div>
                        }
                        <div class="live-session-meta">
                            <span><AssetImage Src="@ClassIcon(State.CharacterClassId)" Alt="" Class="class-image" Fallback="shield" />@T(State.CharacterLabel)</span>
                            <span title="@MonitorLabel"><AppIcon Name="monitor" />@ShortMonitorLabel</span>
                        </div>
                        <div class="live-combat-stats"><CombatStatsReadout Value="@DisplayCombatStats" ObservedCategory="@State.ObservedCombatStatsCategory" SpotId="@State.SpotId" LastKnown="@(!State.IsRunning || FreshCombatStats is null)" /></div>
                    </div>
                </div>
            </div>
            <div class="live-session-actions">
                <div class="live-session-buttons">
                    <button class="button primary" @onclick="() => Act(State.IsRunning ? Tracker.PauseAsync : Tracker.ToggleTrackingAsync)" disabled="@(Acting || (State.IsRunning ? !State.CanPause : State.IsBusy || State.IsSubmitted || !State.AnalyzerAvailable || State.TrackingBlockedReason is not null || State.MissingOcrLanguageTag is not null || State.OcrRestartRequired))" title="@(State.IsSubmitted ? T("Diese Session ist abgeschlossen. Beginne eine neue Session.") : T(State.TrackingBlockedReason))"><AppIcon Name="@(State.IsRunning ? "pause" : "play")" />@(State.IsRunning ? T("Pausieren") : State.HasSession ? T("Fortsetzen") : T("Tracking starten"))</button>
                    <button class="button secondary" @onclick="RequestNew" disabled="@(Acting || State.IsBusy)"><AppIcon Name="plus" />@T("Neue Session")</button>
                </div>
                <div class="live-auto-start">
                    <label class="live-auto-start-toggle">
                        <span>@T("Grind automatisch erkennen")</span>
                        <input id="auto-start-grinding" type="checkbox" class="switch" aria-label="@T("Grind automatisch erkennen")" @bind:get="Tracker.Preferences.AutoStartGrinding" @bind:set="AutoStartChanged" disabled="@(Acting || State.IsBusy)" />
                    </label>
                </div>
            </div>
        </div>
        <div class="metrics-grid live-session-metrics" aria-label="@T("Session-Kennzahlen")">
            <article class="metric-card" title="@SessionMetrics.DurationDescription"><div class="metric-label"><span>@T("AKTIVE ZEIT")</span><AppIcon Name="clock" /></div><strong class="metric-value time-value" aria-describedby="active-time-note active-time-help">@SessionMetrics.Duration</strong><span id="active-time-note" class="metric-note" role="status" aria-live="polite">@SessionMetrics.DurationNote</span><span id="active-time-help" class="sr-only">@SessionMetrics.DurationDescription</span></article>
            <article class="metric-card"><div class="metric-label"><span>TRASHLOOT</span><AppIcon Name="loot" /></div><strong class="metric-value">@SessionMetrics.Trash</strong><span class="metric-note"><span class="teal">@SessionMetrics.TrashHourly</span> @T("pro Stunde")</span></article>
            <article class="metric-card gold-metric"><div class="metric-label"><span>@T("SILBER NETTO")</span><AppIcon Name="silver" /></div><strong class="metric-value">@SessionMetrics.Silver@if (SessionMetrics.PartialSilver) { <span class="estimate-mark" title="@T("Bekannter Teilbetrag. Es fehlen Gegenstandspreise.")"> *</span> }</strong><span class="metric-note">@SessionMetrics.SilverDetail</span></article>
            <article class="metric-card"><div class="metric-label"><span>@T("SILBER / STUNDE")</span><AppIcon Name="trend" /></div><strong class="metric-value">@SessionMetrics.SilverPerHour@if (SessionMetrics.PartialSilverHourly) { <span class="estimate-mark"> *</span> }</strong><span class="metric-note">@T("Ø aktive Grindzeit")</span></article>
        </div>
        <ConsumablesReadout Value="State.Buffs" />
        <SessionTimeline />
    </section>

    @if (State.IsDemo)
    {
        <div class="notice demo-notice live-demo-notice"><AppIcon Name="spark" /><div><strong>Demo</strong><span>@T("Beispieldaten · werden nicht gespeichert oder hochgeladen")</span></div><button class="text-button" @onclick="() => Act(() => Tracker.SetDemoAsync(false))" disabled="@Acting">@T("Demo beenden") <AppIcon Name="close" /></button></div>
    }
    @if (ActionError is not null) { <div class="notice error-notice" role="alert"><AppIcon Name="info" />@T(ActionError)</div> }
    @if (SessionMetrics.LootScrollWarning)
    {
        <div class="notice warning-notice loot-scroll-notice" role="status" aria-live="polite"><AppIcon Name="info" /><span>@T("Loot-Scroll ist nicht aktiv.")</span></div>
    }
    @if (State.IsSubmitted) { <div class="notice"><AppIcon Name="info" /><div><strong>@T("Session abgeschlossen")</strong><span>@T("Diese Session lässt sich nicht weiterführen oder erneut übertragen. Beginne für deinen nächsten Grind eine neue Session.")</span></div></div> }
    @if (!State.IsDemo && (State.MissingOcrLanguageTag is not null || State.OcrInstallationStatus is not null || State.OcrRestartRequired))
    {
        <section class="notice ocr-install-notice @(State.MissingOcrLanguageTag is not null || State.OcrRestartRequired || State.IsError ? "warning-notice" : "success-notice")" aria-labelledby="ocr-install-title">
            <AppIcon Name="@(State.OcrRestartRequired ? "refresh" : "info")" />
            <div class="ocr-install-content">
                <strong id="ocr-install-title">@(State.IsInstallingOcrLanguage ? T("Windows-Texterkennung wird installiert · ") + OcrLanguageLabel : State.OcrRestartRequired ? T("Windows-Neustart erforderlich") : State.MissingOcrLanguageTag is not null ? T("Windows-Texterkennung fehlt · ") + OcrLanguageLabel : T("Windows-Texterkennung"))</strong>
                @if (State.MissingOcrLanguageTag is not null && !State.OcrRestartRequired)
                {
                    <span>@T("Grindcrest benötigt dieses OCR-Sprachpaket, um die Drops in deiner Spielsprache zu erkennen.")</span>
                    <span class="ocr-install-help">@T("Windows fragt nach einer Administratorbestätigung. Der Download benötigt Internet und kann einige Minuten dauern.")</span>
                }
                <div class="ocr-install-status" role="status" aria-live="polite" aria-atomic="true">
                    @if (State.IsInstallingOcrLanguage)
                    {
                        <progress aria-label="@T("OCR-Sprachpaket wird installiert")" max="100" value="@State.OcrInstallationPercent"></progress>
                    }
                    @if (State.OcrInstallationStatus is not null) { <span>@T(State.OcrInstallationStatus)</span> }
                </div>
                <div class="ocr-install-actions">
                    @if (State.MissingOcrLanguageTag is not null)
                    {
                        @if (!State.OcrRestartRequired)
                        {
                            <button class="button primary" @onclick="() => Act(Tracker.InstallOcrLanguageAsync)" disabled="@OcrActionDisabled">@(State.IsInstallingOcrLanguage ? T("Wird installiert …") : T("OCR-Sprachpaket installieren"))</button>
                        }
                        <button class="button secondary" @onclick="RecheckOcrLanguage" disabled="@OcrRecheckDisabled"><AppIcon Name="refresh" />@T("Erneut prüfen")</button>
                    }
                    <button class="text-button" @onclick="OpenSettings" disabled="@(Acting || State.IsInstallingOcrLanguage)">@T("Einstellungen") <AppIcon Name="arrow" /></button>
                </div>
            </div>
        </section>
    }
    @if (!State.IsDemo && State.MissingOcrLanguageTag is null && (!State.AnalyzerAvailable || State.TrackingBlockedReason is not null))
    {
        <div class="notice error-notice tracking-blocked" role="alert"><AppIcon Name="info" /><div><strong>@T("Tracking nicht möglich")</strong><span>@T(State.TrackingBlockedReason ?? State.Status)</span></div><button class="text-button" @onclick="OpenSettings">@T("Einstellungen") <AppIcon Name="arrow" /></button></div>
    }
    else if (!State.IsDemo && State.MissingOcrLanguageTag is null && State.IsError && State.OcrInstallationStatus != State.Status)
    {
        <div class="notice error-notice" role="alert"><AppIcon Name="info" /><span>@T(State.Status)</span></div>
    }

    <div class="live-content-grid">
        <LootTable Title="Drops" Subtitle="" Totals="State.Loot.Totals" DurationTicks="State.Elapsed.Ticks" TrashName="@CurrentProfile?.TrashItemName" EditableSessionId="State.SessionId" AllowAddingItems="true" ShowLastDrop="true" SpotId="@State.SpotId" />
        <div class="session-aside">
            @{ var rating = SessionMetrics.GrindRating; }
            <section class="panel grind-rating-panel" aria-labelledby="grind-rating-title" title="@rating.Description">
                <div class="panel-heading"><h2 id="grind-rating-title">@T("Grind-Bewertung")</h2><AppIcon Name="trend" /></div>
                <div class="grind-rating-heading">
                    <strong class="grind-rating-value @rating.ToneClass"><span class="grind-rating-label">@rating.Label</span></strong>
                    @if (rating.Detail is { } detail) { <span class="grind-rating-status">@detail</span> }
                </div>
                @if (rating.Spectrum is { } spectrum)
                {
                    <div class="grind-rating-hourly">@spectrum.TrashHourly</div>
                    <GrindRatingScale Value="spectrum" />
                    <div class="grind-rating-progress">@spectrum.ProgressLabel</div>
                    <div class="grind-rating-gap">@spectrum.GapLabel</div>
                }
                else
                {
                    <p class="grind-rating-empty">@T("Keine Bewertung verfügbar.")</p>
                }
            </section>
            <section class="panel session-summary">
                <div class="panel-heading"><h2>@T("Session-Details")</h2><AppIcon Name="live" /></div>
                <dl class="detail-list">
                    <div><dt>@T("Bestätigte Drops")</dt><dd>@Number(State.Loot.ConfirmedEventCount)</dd></div>
                    <div><dt>@T("Verschiedene Items")</dt><dd>@State.Loot.ItemTypeCount</dd></div>
                    <div><dt>@T("Bruttowert")</dt><dd>@(CanShowSilver ? Silver(State.Silver.BeforeTax) : "—")@(!State.Silver.IsComplete ? " *" : "")</dd></div>
                    <div><dt>@T("Markterlös")</dt><dd>@Tracker.Preferences.Tax.MarketReturnRate.ToString("P2", UiCulture)</dd></div>
                    <div><dt>Loot-Scroll</dt><dd class="@(SessionMetrics.LootScrollWarning ? "gold" : null)">@SessionMetrics.LootScroll</dd></div>
                    <div><dt>Agris</dt><dd class="agris-live-value"><span>@SessionMetrics.Agris</span>@if (SessionMetrics.AgrisTime.HasObservation) { <small title="@SessionMetrics.AgrisTime.Description" aria-label="@SessionMetrics.AgrisTime.Description">@F("{0} aktiv", SessionMetrics.AgrisTime.Duration)</small> }</dd></div>
                    <div><dt>@T("Erfahrung")</dt><dd class="experience-live-value @(SessionMetrics.Experience.IsLoss ? "is-loss" : "")" title="@SessionMetrics.Experience.Description"><span class="experience-gain">@SessionMetrics.Experience.Gain</span>@if (SessionMetrics.Experience.HasObservation) { <small class="experience-hourly">@SessionMetrics.Experience.Hourly / h</small> }</dd></div>
                    @if (State.Rotation.HasProfile)
                    {
                        <div><dt>@T("Rotationen")</dt><dd class="rotation-live-value"><span>@Number(RotationCount)</span>@if (RotationAverage is { } average) { <small>@F("Ø {0}", BdoGrindTracker.App.Overlay.RotationPhases.Duration(average))</small> }</dd></div>
                        <div><dt>@T("Schnellste Rotation")</dt><dd>@(RotationFastest is { } fastest ? BdoGrindTracker.App.Overlay.RotationPhases.Duration(fastest) : "—")</dd></div>
                        <div><dt>Rotations / h</dt><dd title="@T("Beim aktuellen Tempo: 60 Minuten geteilt durch die durchschnittliche Zeit der letzten bis zu drei Rotationen, jeweils mit Rückweg.")">@(RotationsPerHour is { } perHour ? perHour.ToString("0.0", UiCulture) : "—")</dd></div>
                        @if (State.Rotation.SupportsSpecialEvents)
                        {
                            <div><dt>Special Events</dt><dd class="rotation-live-value"><span>@Number(State.Rotation.SessionSpecialEvents)</span>@if (SpecialEventsPerHour is { } specialRate) { <small>@F("{0} / h", specialRate.ToString("0.0", UiCulture))</small> }</dd></div>
                        }
                    }
                    <div><dt>@T("Automatische Pause")</dt><dd>@F("{0} Min.", Tracker.Preferences.AutoPauseMinutes)</dd></div>
                </dl>
                <div class="subtle-box"><AppIcon Name="shield" /><span>@T("Die automatische Pause greift, wenn kein neuer Loot erkannt wird.")</span></div>
            </section>
            @if (!State.Silver.IsComplete || State.Silver.IsStale)
            {
                <div class="valuation-note"><AppIcon Name="info" /><span>@(!State.Silver.IsComplete ? F("* Teilbetrag: {0} noch ohne verlässlichen Preis. ", string.Join(", ", State.Silver.MissingItems.Concat(State.Silver.OverflowItems).Select(ItemLabel))) : "")@(State.Silver.IsStale ? T("Einige Marktwerte stammen aus dem Cache.") : "")</span></div>
            }
        </div>
    </div>
    @if (!State.IsDemo && !State.HasSession)
    {
        <div class="demo-invitation"><span>@T("Noch nicht im Spiel? Lerne die Oberfläche mit einer Beispielsession kennen.")</span><button class="text-button" @onclick="() => Act(() => Tracker.SetDemoAsync(true))" disabled="@(Acting || State.IsBusy)"><AppIcon Name="spark" />@T("Demo ansehen")</button></div>
    }
</div>

<dialog id="live-confirm" class="modal confirm-modal" aria-labelledby="live-confirm-title" @oncancel="CloseConfirmation">
    <div class="modal-heading"><div><span class="eyebrow">SESSION</span><h2 id="live-confirm-title">@T("Neue Session beginnen?")</h2></div><button class="icon-button" @onclick="CloseConfirmation" aria-label="@T("Dialog schließen")"><AppIcon Name="close" /></button></div>
    <p>@(State.IsDemo ? T("Die Demo wird beendet. Beispieldaten werden nicht im Verlauf gespeichert.") : T("Die aktuelle Session wird beendet und im Verlauf gesichert.")) @T("Für die neue Session beginnen Zeit und Loot wieder bei null.")</p>
    @if (ActionError is not null) { <div class="notice error-notice" role="alert">@T(ActionError)</div> }
    <div class="modal-actions"><button class="button secondary" @onclick="CloseConfirmation">@T("Abbrechen")</button><button class="button primary" @onclick="ConfirmAction" disabled="@Acting">@T("Neue Session")</button></div>
</dialog>

@code {
    private CombatStatsState? FreshCombatStats => CombatStatsSpotRules.ForSpot(State.CombatStats, State.SpotId);
    private CombatStatsState? DisplayCombatStats => FreshCombatStats ?? CombatStatsSpotRules.ForSpot(State.SessionCombatStats, State.SpotId);
    private Task AutoStartChanged(bool enabled) => SavePreferenceChange(p => p with { AutoStartGrinding = enabled });
    private int RotationCount => SessionRotationStats.Count(State.Rotation);
    private double? RotationAverage => SessionRotationStats.Average(State.Rotation);
    private double? RotationFastest => SessionRotationStats.Fastest(State.Rotation);
    private double? RotationsPerHour => SessionRotationStats.PerHour(State.Rotation, Tracker.Preferences.IncludeSpecialEventRotations);
    private double? SpecialEventsPerHour => SessionRotationStats.PerHour(State.Rotation.SessionSpecialEvents, State.Elapsed);
    private void OpenSettings() => Navigation.NavigateTo("/settings/capture");
    private bool _recheckingOcrLanguage;
    private bool OcrActionDisabled => Acting || State.IsBusy || State.IsRunning || State.IsInstallingOcrLanguage || State.IsOcrInstallerRunning;
    private bool OcrRecheckDisabled => _recheckingOcrLanguage || State.IsRunning || (!State.IsInstallingOcrLanguage && (Acting || State.IsBusy));
    private async Task RecheckOcrLanguage()
    {
        if (OcrRecheckDisabled) return;
        _recheckingOcrLanguage = true;
        try
        {
            if (State.IsInstallingOcrLanguage) await Tracker.RecheckOcrLanguageAsync();
            else await Act(Tracker.RecheckOcrLanguageAsync);
        }
        finally { _recheckingOcrLanguage = false; }
    }
    private string OcrLanguageLabel => State.MissingOcrLanguageTag switch
    {
        "de-DE" => T("Deutsch (de-DE)"),
        "en-US" => T("Englisch (en-US)"),
        var tag => tag ?? "",
    };
    private LootSpotPresentation? CurrentProfile => Profile(State.SpotId);
    private IReadOnlyList<LootSpot> SpotVariants => State.SpotId is { } spotId ? LootSpotCatalog.VariantsFor(spotId) : [];
    private bool ShowSpotVariantSelection => SpotVariants.Count > 1 ||
        SpotVariants.Count == 1 && SpotVariants[0].Id != State.SpotId;
    private async Task SelectSpotVariant(Guid sessionId, ChangeEventArgs args)
    {
        if (args.Value is string spotId)
            await Act(() => Tracker.SelectSpotVariantAsync(sessionId, spotId));
    }
    private LiveSessionPresentation SessionMetrics => new(State, UiLanguage);
    private bool CanShowSilver => SessionMetrics.CanShowSilver;
    private string HeroStyle => CurrentProfile is null
        ? "--live-session-artwork:url('assets/spot-backgrounds/aphrodon.jpg')"
        : CurrentProfile.BackgroundFileName is { } background
            ? $"--live-session-artwork:url('assets/spot-backgrounds/{background}')"
            : "--live-session-artwork:none";
    private string MonitorLabel => T(Tracker.CapturesGameWindow ? "Black Desert · Spielfenster" : Tracker.Monitors.FirstOrDefault(monitor => monitor.DeviceName == Tracker.Preferences.MonitorDeviceName)?.Label ?? Tracker.Monitors.FirstOrDefault()?.Label ?? "Kein Bildschirm");
    private string ShortMonitorLabel => MonitorLabel.Split('·')[0].Trim();
    private string SessionStatus => SessionMetrics.Status;
    private async Task RequestNew()
    {
        ClearActionError();
        if (!State.HasSession && !State.IsDemo) { await Act(Tracker.NewSessionAsync); return; }
        await JS.InvokeVoidAsync("grindcrest.showDialog", "live-confirm");
    }
    private async Task CloseConfirmation() => await JS.InvokeVoidAsync("grindcrest.closeDialog", "live-confirm");
    private async Task ConfirmAction()
    {
        if (State.IsRunning && !await Act(Tracker.PauseAsync)) return;
        if (await Act(Tracker.NewSessionAsync)) await CloseConfirmation();
    }
}
