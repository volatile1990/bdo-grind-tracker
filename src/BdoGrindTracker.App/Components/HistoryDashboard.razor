@page "/history"
@page "/history/spots/{SpotId}"
@page "/history/spots/{SpotId}/{SessionId:guid}"
@inject NavigationManager Navigation
@inherits TrackerComponentBase
@inject IJSRuntime JS

@{
    // All visible totals, counts and rows use the same projection for this render.
    var filtered = Filtered.ToArray();
    var visibleSessions = (_spotId is null ? filtered : filtered.Where(session => session.SpotId == _spotId))
        .OrderByDescending(session => session.StartedAt).ToArray();
    var visibleProfiles = VisibleProfiles.ToArray();
    var pageCount = Math.Max(1, (visibleSessions.Length + PageSize - 1) / PageSize);
    _page = Math.Clamp(_page, 1, pageCount);
}
<div class="page menu-page history-page">
    <div class="page-heading menu-page-heading"><h1>@(_spotId is null ? T("Verlauf") : SpotName(_spotId))</h1>@if (_spotId is not null) { <button class="button secondary" @onclick="BackToSpots"><AppIcon Name="back" />@T(_allSessions ? "Alle Sessions" : "Alle Grindspots")</button> }</div>
    @if (ActionError is not null) { <div class="notice error-notice" role="alert"><AppIcon Name="info" />@T(ActionError)</div> }
    @if (_routeWarning is not null) { <div class="notice warning-notice" role="status"><AppIcon Name="info" />@T(_routeWarning)</div> }
    <div class="settings-workspace menu-workspace history-workspace">
        <MenuNavigation Label="Verlaufsbereiche" Sections="OverviewSections" Selected="@(_allSessions ? "all" : "spots")" OnSelect="SelectOverview" Disabled="@(Acting || State.IsBusy)" />
        <div class="menu-content history-menu-content">
    <div class="history-filters">
        @if (_spotId is null) { <label class="search-field"><AppIcon Name="search" /><input placeholder="@T("Grindspot suchen …")" aria-label="@T("Grindspot suchen")" @bind="_query" @bind:event="oninput" @bind:after="FiltersChanged" /></label> }
        <label class="filter-field"><span>@T("Zeitraum")</span><select @bind="_days" @bind:after="FiltersChanged"><option value="0">@T("Gesamter Verlauf")</option><option value="7">@T("Letzte 7 Tage")</option><option value="30">@T("Letzte 30 Tage")</option><option value="90">@T("Letzte 90 Tage")</option></select></label>
        <label class="filter-field"><span>@T("Klasse")</span><select @bind="_class" @bind:after="FiltersChanged"><option value="">@T("Alle Klassen")</option>@foreach (var characterClass in HistoryClasses) { <option value="@characterClass">@characterClass</option> }</select></label>
        <span class="filter-count">@F("{0} Sessions", visibleSessions.Length)</span>
    </div>
    @if (_spotId is null)
    {
        var all = visibleSessions;
        var time = TimeSpan.FromTicks(all.Sum(session => session.Duration.Ticks));
        var silver = all.Sum(session => session.SilverAfterTax);
        <div class="history-overview-stats"><div><span>SESSIONS</span><strong>@all.Length</strong></div><div><span>@T("GRINDZEIT")</span><strong>@ShortDuration(time)</strong></div><div><span>@T("SILBER NETTO")</span><strong class="gold">@(all.Length > 0 ? Silver(silver) : "—")@PartialMark(all)</strong></div><div><span>@T("Ø SILBER / STUNDE")</span><strong>@(time > TimeSpan.Zero ? Silver(Hourly(silver, time)) : "—")@PartialMark(all)</strong></div></div>
        @if (all.Any(entry => !entry.SilverIsComplete)) { <p class="valuation-note">@T("* Enthält Sessions mit unvollständigen Silberwerten.")</p> }
        @if (Tracker.History.Count == 0) { <div class="notice"><AppIcon Name="history" /><div><strong>@T("Deine Geschichte beginnt mit der ersten Session.")</strong><span>@T("Erfasste Sessions werden automatisch lokal gesichert. Wähle einen Spot, um seine Details zu entdecken.")</span></div><button class="text-button" @onclick="OnLive">@T("Zur Live-Session") <AppIcon Name="arrow" /></button></div> }
        <div class="section-title"><h2>@(_allSessions ? T("Alle Sessions") : T("Grindspots"))</h2></div>
        @if (_allSessions)
        {
            var chronological = visibleSessions;
            <section class="panel chronological-history" aria-label="@T("Alle gespeicherten Sessions")">
                @foreach (var session in chronological.Skip((_page - 1) * PageSize).Take(PageSize))
                {
                    <details class="chronological-session-card" @key="session.SessionId">
                        <summary class="chronological-session-header" style="@SpotBackgroundStyle(Profile(session.SpotId), shaded: true)">
                            <span class="chronological-date"><strong>@session.StartedAt.ToLocalTime().ToString(UiLanguage == "en" ? "MMM d, yy" : "dd.MM.yy", UiCulture)</strong><small>@session.StartedAt.ToLocalTime().ToString(UiLanguage == "en" ? "h:mm tt" : "HH:mm 'Uhr'", UiCulture)</small></span>
                            <span class="chronological-spot"><AssetImage Src="@("assets/spot-icons/" + Profile(session.SpotId)?.IconFileName)" Alt="" Class="chronological-spot-icon" /><span><strong>@SpotName(session.SpotId)</strong><small>@(session.CharacterClass ?? T("Klasse nicht erkannt"))</small><CombatStatsReadout Value="@session.CombatStats" SpotId="@session.SpotId" Saved="true" Compact="true" />@if (session.GarmothLocallyModified) { <small class="session-local-correction">@T("Lokal korrigiert; Garmoth unverändert")</small> }</span></span>
                            <span class="chronological-loot-preview">
                                @foreach (var item in ChronologicalLoot(session))
                                {
                                    <span class="chronological-loot-badge" title="@ItemLabel(item.Key)"><AssetImage Src="@ItemIcon(item.Key)" Alt="@ItemLabel(item.Key)" Class="item-image" /><small>@Number(item.Value)</small></span>
                                }
                            </span>
                            <span class="chronological-session-duration"><small>@T("GRINDZEIT")</small><strong>@ShortDuration(session.Duration)</strong><small class="session-agris-time" title="@HistoryPresentation.AgrisTime(session, UiLanguage).Description" aria-label="@HistoryPresentation.AgrisTime(session, UiLanguage).Description">Agris @HistoryPresentation.AgrisTime(session, UiLanguage).Duration</small></span>
                            <span class="chronological-session-experience @(HistoryPresentation.Experience(session, UiLanguage).IsLoss ? "is-loss" : "")" title="@HistoryPresentation.Experience(session, UiLanguage).Description"><small>@T("ERFAHRUNG")</small><strong class="experience-gain">@HistoryPresentation.Experience(session, UiLanguage).Gain</strong>@if (HistoryPresentation.Experience(session, UiLanguage).HasObservation) { <small class="experience-hourly">@HistoryPresentation.Experience(session, UiLanguage).Hourly / h</small> }</span>
                            <span class="chronological-session-silver"><strong>@Silver(session.SilverAfterTax)@(!session.SilverIsComplete ? " *" : "")</strong><small>@Silver(Hourly(session.SilverAfterTax, session.Duration)) / h</small></span>
                            <span class="chronological-expand" aria-hidden="true"><AppIcon Name="chevron" /></span>
                        </summary>
                        <div class="chronological-session-details">
                            <div class="chronological-session-actions"><span>@T("Loot dieser Session · aktuelle Preise")</span><div>
                                <button class="button secondary" @onclick="() => OpenSession(session)"><AppIcon Name="pin" />@T("Zum Grindspot")</button>
                                <button class="button secondary" @onclick="() => Edit(session)" disabled="@(Acting || State.IsBusy || IsCurrent(session))">@T("Bearbeiten")</button>
                                <button class="button secondary danger" @onclick="() => AskDelete(session)" disabled="@(Acting || State.IsBusy || IsCurrent(session))"><AppIcon Name="delete" />@T("Löschen")</button>
                            </div></div>
                            <LootTable Totals="SessionTotals(session)" DurationTicks="session.Duration.Ticks" TrashName="@(Profile(session.SpotId)?.TrashItemName)" Title="@T("Loot der Session")" Subtitle="@T("Mengen und Bewertung im Detail")" EditableSessionId="session.SessionId" />
                            @if (session.Buffs is not null) { <ConsumablesReadout Value="session.Buffs" /> }
                        </div>
                    </details>
                }
                @if (chronological.Length == 0) { <div class="empty-state"><div class="empty-symbol"><AppIcon Name="history" /></div><h3>@T("Keine passenden Sessions")</h3><p>@T("Wähle einen anderen Zeitraum oder starte deinen nächsten Grind.")</p></div> }
                else { <div class="pagination"><span>@F("{0}–{1} von {2} Sessions", ((_page - 1) * PageSize) + 1, Math.Min(_page * PageSize, chronological.Length), chronological.Length)</span><div><button class="icon-button" aria-label="@T("Vorherige Seite")" @onclick="() => ChangePage(_page - 1)" disabled="@(_page <= 1)"><AppIcon Name="back" /></button><span>@F("Seite {0} von {1}", _page, pageCount)</span><button class="icon-button" aria-label="@T("Nächste Seite")" @onclick="() => ChangePage(_page + 1)" disabled="@(_page >= pageCount)"><AppIcon Name="arrow" /></button></div></div> }
            </section>
        }
        else
        {
        <div class="spot-grid">
            @foreach (var profile in visibleProfiles)
            {
                var sessions = filtered.Where(session => session.SpotId == profile.SpotId).ToArray();
                var metrics = HistoryPresentation.CalculateMetrics(profile, sessions);
                <button class="spot-card" @onclick="() => OpenSpot(profile.SpotId)">
                    <div class="spot-card-art" style="@SpotBackgroundStyle(profile)"><span class="spot-session-count">@sessions.Length @(sessions.Length == 1 ? "Session" : "Sessions")</span><AssetImage Src="@("assets/spot-icons/" + profile.IconFileName)" Alt="" Class="spot-card-emblem" Fallback="pin" /><div><span class="eyebrow">@profile.RegionName.ToUpperInvariant()</span><h3>@SpotName(profile.SpotId)</h3></div></div>
                    <div class="spot-card-body"><div class="spot-card-stats"><div><span>@T("Ø SILBER / H")</span><strong>@(sessions.Length > 0 ? Silver(metrics.AverageSilverPerHour) : "—")@PartialMark(sessions)</strong></div><div><span>TRASH / H</span><strong>@(sessions.Length > 0 ? Number(metrics.TrashPerHour) : "—")</strong></div></div><div class="spot-card-footer"><span>@SpotGuidanceSummary(profile)</span><span>@T("Spot ansehen") <AppIcon Name="arrow" /></span></div></div>
                </button>
            }
        </div>
        @if (visibleProfiles.Length == 0) { <div class="empty-state"><AppIcon Name="search" /><h3>@T("Kein Grindspot gefunden")</h3><p>@T("Versuche einen anderen Suchbegriff.")</p><button class="button secondary" @onclick="ClearSearch">@T("Suche zurücksetzen")</button></div> }
        }
    }
    else if (Profile(_spotId) is { } profile)
    {
        var sessions = visibleSessions;
        var metrics = HistoryPresentation.CalculateMetrics(profile, sessions);
        var chart = HistoryPresentation.BuildChartData(profile, sessions);
        <section class="spot-detail-hero" style="@SpotBackgroundStyle(profile)">
            <div class="hero-shade"></div>
            <div class="spot-detail-content">
                <div class="spot-detail-identity"><AssetImage Src="@("assets/spot-icons/" + profile.IconFileName)" Alt="" Class="spot-emblem" /><div><span class="eyebrow">@T("SPOT-GUIDE")</span><h2>@SpotName(_spotId)</h2><p>@ItemLabel(profile.TrashItemName) · @F("{0} Silber / Stück", Number(profile.TrashSilver))</p></div></div>
                <div class="spot-guidance">
                    @if (profile.RecommendedAp is { } recommendedAp)
                    {
                        <div><span>@T("EMPFOHLENE AP")</span><strong>@Number(recommendedAp)</strong>@if (profile.MaxApLimit is { } cap) { <small>@F("AP-Limit {0}", Number(cap))</small> }</div>
                    }
                    else if (profile.MaxApLimit is { } knownLimit)
                    {
                        <div><span>@T("AP-LIMIT")</span><strong>@Number(knownLimit)</strong><small>@T("Gesamte AP")</small></div>
                    }
                    @if (profile.RecommendedDp is { } recommendedDp)
                    {
                        <div><span>@T("EMPFOHLENE DP")</span><strong>@Number(recommendedDp)</strong><small>@T("Verteidigung")</small></div>
                    }
                    @if (profile.RecommendedCrystalName is { } crystal && profile.RecommendedCrystalFileName is { } crystalFile)
                    {
                        <div class="crystal-guidance"><AssetImage Src="@("assets/crystal-icons/" + crystalFile)" Alt="" Class="crystal-image" Fallback="spark" /><div><span>@T("KRISTALL-EMPFEHLUNG")</span><strong>@crystal</strong><small>@string.Join(" · ", profile.Traits.Where(LootSpotPresentationCatalog.IsResistanceTrait).Select(Trait))</small></div></div>
                    }
                </div>
                <div class="trait-list">@foreach (var trait in profile.Traits.Where(trait => !LootSpotPresentationCatalog.IsResistanceTrait(trait))) { <span>@Trait(trait)</span> }</div>
            </div>
        </section>

        <p class="valuation-note">@T("Bewertung mit aktuellen Preisen und Steuereinstellungen · Silber pro Stunde berücksichtigt Lootmenge und Grindzeit.")</p>
        <div class="history-metrics-grid">
            <article class="metric-card gold-metric"><span class="metric-label">@T("SILBER NETTO GESAMT")</span><strong class="metric-value">@(sessions.Length > 0 ? Silver(metrics.TotalSilver) : "—")@PartialMark(sessions)</strong><Sparkline Values="chart.CumulativeSilver" Label="@T("Kumulierter Silberwert deiner Sessions")" /></article>
            <article class="metric-card"><span class="metric-label">@T("Ø SILBER / STUNDE")</span><strong class="metric-value">@(sessions.Length > 0 ? Silver(metrics.AverageSilverPerHour) : "—")@PartialMark(sessions)</strong><Sparkline Values="chart.SilverPerHour" Label="@T("Silber pro Stunde je Session")" /></article>
            <article class="metric-card"><span class="metric-label">@T("TRASH / STUNDE")</span><strong class="metric-value teal">@(sessions.Length > 0 ? Number(metrics.TrashPerHour) : "—")</strong><Sparkline Values="chart.TrashPerHour" Label="@T("Trashloot pro Stunde je Session")" /></article>
        </div>
        <div class="history-secondary-metrics"><div><span>@T("Ø Trash · letzte 5 Grindstunden")</span><strong>@(sessions.Length > 0 ? Number(metrics.RecentFiveHourTrashPerHour) : "—") / h</strong></div><div><span>@T("Ø Trash · beste 5 Grindstunden")</span><strong>@(sessions.Length > 0 ? Number(metrics.BestFiveHourTrashPerHour) : "—") / h</strong></div><div><span>@T("Ø Silber / h · beste 5 Trash-Sessions")</span><strong>@(sessions.Length > 0 ? Silver(metrics.BestFiveHourAverageSilverPerHour) : "—")@PartialMark(sessions)</strong></div></div>
        @if (sessions.Any(entry => !entry.SilverIsComplete)) { <p class="valuation-note">@T("* Enthält Sessions mit unvollständigen Silberwerten. Die Kennzahlen verwenden aktuelle Preise und Steuereinstellungen.")</p> }
        <section class="panel history-sessions"><div class="panel-heading"><div><h2>Sessions <span class="count-pill">@sessions.Length</span></h2><p>@F("Gespeicherte Ergebnisse · {0} aktive Zeit", ShortDuration(TimeSpan.FromHours((double)metrics.TotalHours)))</p></div></div>
            @if (sessions.Length == 0) { <div class="empty-state"><div class="empty-symbol"><AppIcon Name="history" /></div><h3>@T("Noch keine passenden Sessions")</h3><p>@(Tracker.History.Any(session => session.SpotId == _spotId) ? T("Für diesen Zeitraum oder diese Klasse gibt es keine Einträge.") : T("Deine erfassten Sessions an diesem Spot erscheinen hier automatisch."))</p><button class="button secondary" @onclick="OnLive">@T("Zur Live-Session") <AppIcon Name="arrow" /></button></div> }
            else
            {
                var lootColumns = BuildLootColumns(profile, sessions);
                <p id="session-column-help" class="session-table-help">@T("Mausrad: Seite scrollen · Umschalt + Mausrad: Tabelle seitlich scrollen. Lootspalten lassen sich ziehen oder mit Alt + Pfeil links/rechts verschieben. Enter oder Leertaste setzt einen Favoriten.")</p>
                <span class="sr-only" role="status" aria-live="polite">@T(_columnStatus)</span>
                <div id="spot-session-table-scroll" class="spot-session-table-scroll" tabindex="0" role="region" aria-label="@T("Lootmengen der gefilterten Sessions")" aria-describedby="session-column-help">
                    <table class="spot-session-table" style="@SessionTableWidth(lootColumns.Count)">
                        <thead><tr>
                            <th class="session-fixed session-class-column" scope="col">@T("KLASSE")</th>
                            <th class="session-fixed session-age-column" scope="col">@T("WIE LANG HER")</th>
                            <th class="session-fixed session-duration-column" scope="col">@T("GRINDZEIT")</th>
                            <th class="session-fixed session-silver-column numeric" scope="col">@T("SILBER / H")</th>
                            <th class="session-experience-column" scope="col">@T("ERFAHRUNG")</th>
                            <th class="session-combat-column" scope="col">AP / DP</th>
                            <th class="session-consumables-column" scope="col">@T("VERBRAUCHT")</th>
                            @for (var columnIndex = 0; columnIndex < lootColumns.Count; columnIndex++)
                            {
                                var column = lootColumns[columnIndex];
                                <th class="session-loot-column" scope="col" title="@ColumnPriceTooltip(column.Name)" data-loot-name="@column.Name" @key="column.Name"><button type="button" class="session-favorite-button @(IsFavorite(column.Name) ? "is-favorite" : "")" aria-label="@(F("{0} · Lootspalte {1} von {2}", ItemLabel(column.Name), columnIndex + 1, lootColumns.Count) + (IsFavorite(column.Name) ? T(" – Favorit entfernen") : T(" – als Favorit markieren")))" aria-pressed="@(IsFavorite(column.Name) ? "true" : "false")" aria-keyshortcuts="Alt+ArrowLeft Alt+ArrowRight" aria-describedby="session-column-help" disabled="@(Acting || State.IsBusy)" @onclick="e => KeyboardFavorite(e, column.Name)"><AssetImage Src="@ItemIcon(column.Name)" Alt="" Class="session-loot-icon" Fallback="loot" />@if (IsFavorite(column.Name)) { <span class="session-favorite-star" aria-hidden="true">★</span> }</button><small>@Silver(column.SilverPerHour) / h</small></th>
                            }
                            <th class="session-actions-column" scope="col">@T("AKTIONEN")</th>
                        </tr></thead>
                        <tbody>
                        @foreach (var session in sessions.Skip((_page - 1) * PageSize).Take(PageSize))
                        {
                            <tr @key="session.SessionId" data-session-id="@session.SessionId" class="@(_expanded == session.SessionId ? "selected" : "")" aria-label="@(session.GarmothLocallyModified ? T("Lokal korrigiert; Garmoth unverändert") : null)">
                                <td class="session-fixed session-class-column"><AssetImage Src="@ClassIcon(session.CharacterClass)" Alt="" Class="session-class-icon" Fallback="shield" /><span class="sr-only">@(session.CharacterClass ?? T("Klasse nicht erkannt"))</span></td>
                                <td class="session-fixed session-age-column" title="@session.StartedAt.ToLocalTime().ToString("g", UiCulture)">@HistoryPresentation.FormatTimeAgo(session.StartedAt, DateTimeOffset.Now, UiLanguage)@if (session.GarmothLocallyModified) { <small class="session-local-correction" title="@T("Lokal korrigiert; Garmoth unverändert")">@T("Lokal korrigiert; Garmoth unverändert")</small> }</td>
                                <td class="session-fixed session-duration-column">@CompactDuration(session.Duration)<small class="session-agris-time" title="@HistoryPresentation.AgrisTime(session, UiLanguage).Description" aria-label="@HistoryPresentation.AgrisTime(session, UiLanguage).Description">Agris @HistoryPresentation.AgrisTime(session, UiLanguage).Duration</small></td>
                                <td class="session-fixed session-silver-column numeric gold">@Silver(Hourly(session.SilverAfterTax, session.Duration))@(!session.SilverIsComplete ? " *" : "")</td>
                                <td class="session-experience-column @(HistoryPresentation.Experience(session, UiLanguage).IsLoss ? "is-loss" : "")" title="@HistoryPresentation.Experience(session, UiLanguage).Description"><strong class="experience-gain">@HistoryPresentation.Experience(session, UiLanguage).Gain</strong>@if (HistoryPresentation.Experience(session, UiLanguage).HasObservation) { <small class="experience-hourly">@HistoryPresentation.Experience(session, UiLanguage).Hourly / h</small> }</td>
                                <td class="session-combat-column"><CombatStatsReadout Value="@session.CombatStats" SpotId="@session.SpotId" Saved="true" Compact="true" /></td>
                                <td class="session-consumables-column"><ConsumablesReadout Value="session.Buffs" Compact="true" /></td>
                                @foreach (var column in lootColumns)
                                {
                                    var quantity = SessionTotals(session).GetValueOrDefault(column.Name);
                                    <td class="session-loot-quantity numeric" @key="column.Name"><LootQuantityEditor SessionId="session.SessionId" ItemName="@column.Name" Quantity="quantity" DisplayQuantity="@(quantity > 0 ? Number(quantity) : "—")" /></td>
                                }
                                <td class="session-actions-column"><button type="button" class="icon-button session-edit-button" aria-label="@T("Session bearbeiten")" title="@T("Klasse und Loot der Session bearbeiten")" @onclick="() => Edit(session)" disabled="@(Acting || State.IsBusy || IsCurrent(session))"><AppIcon Name="edit" /></button><button type="button" class="icon-button session-delete-button" aria-label="@T("Session löschen")" title="@T("Session löschen")" @onclick="() => AskDelete(session)" disabled="@(Acting || State.IsBusy || IsCurrent(session))"><AppIcon Name="delete" /></button></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <div class="pagination"><span>@F("{0}–{1} von {2} Sessions", ((_page - 1) * PageSize) + 1, Math.Min(_page * PageSize, sessions.Length), sessions.Length)</span><div><button class="icon-button" aria-label="@T("Vorherige Seite")" @onclick="() => ChangePage(_page - 1)" disabled="@(_page <= 1)"><AppIcon Name="back" /></button><span>@F("Seite {0} von {1}", _page, pageCount)</span><button class="icon-button" aria-label="@T("Nächste Seite")" @onclick="() => ChangePage(_page + 1)" disabled="@(_page >= pageCount)"><AppIcon Name="arrow" /></button></div></div>
            }
        </section>
        @if (sessions.Length > 0) { <LootTable Totals="AggregateTotals(sessions)" DurationTicks="sessions.Sum(session => session.Duration.Ticks)" TrashName="@profile.TrashItemName" Title="@T("Gesamter Loot am Spot")" Subtitle="@T("Alle gefilterten Sessions · Einzelwerte mit den aktuellen Preiseinstellungen")" /> }
    }
        </div>
    </div>
</div>

<dialog id="history-edit" class="modal edit-modal" aria-labelledby="history-edit-title" @oncancel="CloseDialogs"><div class="modal-heading"><div><span class="eyebrow">@T("SESSION BEARBEITEN")</span><h2 id="history-edit-title">@T("Lootmengen korrigieren")</h2></div><button class="icon-button" @onclick="CloseDialogs" aria-label="@T("Dialog schließen")"><AppIcon Name="close" /></button></div><p>@T("Trage die tatsächlichen Gesamtmengen ein. Mit 0 setzt du die Menge eines Gegenstands zurück.")</p>
    @if (_target?.GarmothUploadedAt is not null || _target?.GarmothUploadBlocked == true) { <div class="notice warning-notice"><AppIcon Name="info" />@T("Bereits übertragene Garmoth-Einträge werden dadurch nicht geändert.")</div> }
    @if (_dialogError is not null) { <div class="notice error-notice" role="alert">@T(_dialogError)</div> }
    @if (_target is { } editSession) { <div class="history-edit-combat"><span>@T("Im Spiel erfasste Werte dieser Session")</span><CombatStatsReadout Value="@editSession.CombatStats" SpotId="@editSession.SpotId" Saved="true" /></div>@if (editSession.Buffs is not null) { <ConsumablesReadout Value="editSession.Buffs" /> } }
    <form @onsubmit="SaveEdit" @onsubmit:preventDefault><label class="field history-class-edit"><span>@T("Klasse dieser Session")</span><select @bind="_editClass"><option value="">@T("Klasse nicht erkannt")</option>@foreach (var characterClass in CompanionCharacterClassCatalog.Classes) { <option value="@characterClass.DisplayName">@characterClass.DisplayName</option> }</select></label><div class="edit-loot-list">@foreach (var row in _editRows) { <label class="edit-loot-row"><span><AssetImage Src="@ItemIcon(row.Name)" Alt="" Class="item-image" />@ItemLabel(row.Name)</span><input type="number" min="0" max="9223372036854775807" step="1" required @bind="row.Quantity" aria-label="@(T("Menge ") + ItemLabel(row.Name))" /></label> }</div><div class="modal-actions"><button type="button" class="button secondary" @onclick="CloseDialogs">@T("Abbrechen")</button><button type="submit" class="button primary" disabled="@Acting"><AppIcon Name="check" />@T("Session speichern")</button></div></form>
</dialog>
<dialog id="history-confirm" class="modal confirm-modal" aria-labelledby="history-confirm-title" @oncancel="CloseDialogs">
    <div class="modal-heading"><div><span class="eyebrow">@T("VERLAUF")</span><h2 id="history-confirm-title">@T("Session löschen?")</h2></div><button class="icon-button" @onclick="CloseDialogs" aria-label="@T("Dialog schließen")"><AppIcon Name="close" /></button></div>
    <p>@T("Diese Session wird dauerhaft aus deinem lokalen Verlauf entfernt. Bereits hochgeladene Garmoth-Einträge bleiben bestehen.")</p>
    @if (_target is { } selected) { <div class="confirm-summary"><strong>@SpotName(selected.SpotId)</strong><span>@selected.StartedAt.ToLocalTime().ToString("g", UiCulture) · @ShortDuration(selected.Duration)</span></div> }
    <div class="modal-actions"><button class="button secondary" @onclick="CloseDialogs">@T("Abbrechen")</button><button class="button danger" @onclick="ConfirmDelete" disabled="@Acting">@T("Session löschen")</button></div>
</dialog>

@code {
    [Parameter] public string? SpotId { get; set; }
    [Parameter] public Guid? SessionId { get; set; }
    [SupplyParameterFromQuery(Name = "view")] public string? QueryView { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? QuerySearch { get; set; }
    [SupplyParameterFromQuery(Name = "days")] public string? QueryDays { get; set; }
    [SupplyParameterFromQuery(Name = "class")] public string? QueryClass { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public string? QueryPage { get; set; }
    [SupplyParameterFromQuery(Name = "hourly")] public string? QueryHourly { get; set; }
    [SupplyParameterFromQuery(Name = "edit")] public string? QueryEdit { get; set; }
    private const int PageSize = 8;
    private IReadOnlyList<MenuSection> OverviewSections =>
    [
        new("spots", "Grindspots", "pin", HistoryPath(null, allSessions: false, page: 1)),
        new("all", "Alle Sessions", "history", HistoryPath(null, allSessions: true, page: 1))
    ];
    private string? _spotId;
    private string _query = "", _class = "";
    private int _days, _page = 1;
    private bool _hourly, _allSessions;
    private Guid? _expanded;
    private LootHistoryEntry? _target;
    private string? _dialogError;
    private string _editClass = "";
    private List<EditRow> _editRows = [];
    private string? _routeWarning;
    private string? _columnStatus;
    private RouteParameters? _lastRouteParameters;
    private sealed record RouteParameters(string? SpotId, Guid? SessionId, string? View, string? Search,
        string? Days, string? CharacterClass, string? Page, string? Hourly, string? Edit);
    private bool _closeDialogsAfterRender;
    private bool _showEditAfterRender;
    private sealed class EditRow { public required string Name { get; init; } public string Quantity { get; set; } = "0"; }
    private sealed record LootColumn(string Name, decimal SilverPerHour);
    private IEnumerable<string> HistoryClasses => Tracker.History.Select(session => session.CharacterClass).Where(name => !string.IsNullOrWhiteSpace(name)).Cast<string>().Distinct().Order();
    private IEnumerable<LootHistoryEntry> Filtered => Tracker.History
        .Where(session => (_days == 0 || session.StartedAt >= DateTimeOffset.Now.AddDays(-_days))
            && (_class.Length == 0 || session.CharacterClass == _class)
            && (_spotId is not null || MatchesSearch(session.SpotId)))
        .Select(ValueAtCurrentPrices);
    private bool MatchesSearch(string spotId) => SpotName(spotId).Contains(_query.Trim(), StringComparison.OrdinalIgnoreCase);
    private IEnumerable<LootSpotPresentation> VisibleProfiles => LootSpotPresentationCatalog.Profiles.Where(profile => MatchesSearch(profile.SpotId));
    private IEnumerable<LootHistoryEntry> SpotSessions => Filtered.Where(session => session.SpotId == _spotId).OrderByDescending(session => session.StartedAt);
    private IEnumerable<LootHistoryEntry> AllSessions => Filtered.OrderByDescending(session => session.StartedAt);
    private int PageCount => Math.Max(1, (SpotSessions.Count() + PageSize - 1) / PageSize);
    private int AllPageCount => Math.Max(1, (AllSessions.Count() + PageSize - 1) / PageSize);
    private LootHistoryEntry ValueAtCurrentPrices(LootHistoryEntry entry)
    {
        var value = SilverValuation.Calculate(entry.Totals, Tracker.Prices, Tracker.Preferences.Tax);
        return entry with { SilverBeforeTax = value.BeforeTax, SilverAfterTax = value.AfterTax, SilverIsComplete = value.IsComplete };
    }
    private static string PartialMark(IEnumerable<LootHistoryEntry> sessions) => sessions.Any(entry => !entry.SilverIsComplete) ? " *" : "";
    protected override void OnParametersSet()
    {
        // URI notifications and tracker refreshes can render the parent before
        // the router/query supplier has delivered new component parameters.
        // Compare the received values so an early render cannot consume a URI
        // change and then discard its actual parameters on the next render.
        var parameters = new RouteParameters(SpotId, SessionId, QueryView, QuerySearch,
            QueryDays, QueryClass, QueryPage, QueryHourly, QueryEdit);
        if (_lastRouteParameters == parameters) return;
        _closeDialogsAfterRender = _lastRouteParameters is not null;
        _lastRouteParameters = parameters;
        _target = null; _dialogError = null; _editRows = [];
        _showEditAfterRender = false;
        _routeWarning = null;
        _columnStatus = null;
        _spotId = Profile(SpotId) is not null ? SpotId : null;
        if (SpotId is not null && _spotId is null) _routeWarning = "Dieser Grindspot ist nicht verfügbar. Hier findest du alle unterstützten Spots.";
        _allSessions = string.Equals(QueryView, "all", StringComparison.Ordinal);
        _query = QuerySearch ?? "";
        _class = QueryClass ?? "";
        _days = int.TryParse(QueryDays, NumberStyles.None, CultureInfo.InvariantCulture, out var days) && days is 7 or 30 or 90 ? days : 0;
        _hourly = QueryHourly == "1";
        _page = int.TryParse(QueryPage, NumberStyles.None, CultureInfo.InvariantCulture, out var page) ? Math.Max(1, page) : 1;
        _page = Math.Min(_page, _spotId is null ? AllPageCount : PageCount);
        _expanded = null;
        if (_spotId is not null && SessionId is { } sessionId)
        {
            var sessions = SpotSessions.ToArray();
            var index = Array.FindIndex(sessions, session => session.SessionId == sessionId);
            if (index >= 0)
            {
                _expanded = sessionId; _page = index / PageSize + 1;
                if (QueryEdit == "1" && !IsCurrent(sessions[index]) && !State.IsBusy)
                {
                    PrepareEdit(sessions[index]);
                    _showEditAfterRender = true;
                }
            }
            else _routeWarning = "Diese Session ist nicht mehr vorhanden oder passt nicht zu den gewählten Filtern.";
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        try
        {
            if (_closeDialogsAfterRender)
            {
                _closeDialogsAfterRender = false;
                await CloseDialogs();
                if (_disposed) return;
            }
            if (_showEditAfterRender)
            {
                _showEditAfterRender = false;
                await JS.InvokeVoidAsync("grindcrest.showDialog", "history-edit");
                if (_disposed) return;
            }
            if (_spotId is { } spotId)
            {
                await JS.InvokeVoidAsync("grindcrest.enableHorizontalWheel", "spot-session-table-scroll");
                // Navigation can dispose this component while JS acknowledges
                // the previous call. Never revive or serialize its old receiver.
                if (_disposed || _spotId != spotId) return;
                _dragReference ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("grindcrest.enableColumnDrag", "spot-session-table-scroll", _dragReference, spotId);
            }
        }
        catch (Exception exception) when (_disposed && exception is
            ObjectDisposedException or JSDisconnectedException or OperationCanceledException) { }
    }
    private void OnLive() => Navigation.NavigateTo("/");
    private void FiltersChanged() { _page = 1; NavigateHistory(_spotId, null, replace: true); }
    private void ClearSearch() { _query = ""; FiltersChanged(); }
    private void SelectOverview(string section)
    {
        if (Acting || State.IsBusy) return;
        SetOverview(section == "all");
    }
    private void SetOverview(bool allSessions)
    {
        if (_allSessions == allSessions && _spotId is null) return;
        _allSessions = allSessions; _page = 1; NavigateHistory(null);
    }
    private void OpenSession(LootHistoryEntry session) { _page = 1; NavigateHistory(session.SpotId, session.SessionId); }
    private void OpenSpot(string id) { _page = 1; NavigateHistory(id); }
    private void BackToSpots() { _page = 1; NavigateHistory(null); }
    private void ToggleSession(Guid id) => NavigateHistory(_spotId, _expanded == id ? null : id);
    private void ChangePage(int page)
    {
        _page = Math.Clamp(page, 1, _spotId is null ? AllPageCount : PageCount);
        NavigateHistory(_spotId, null, replace: true);
    }
    private void SetHourly(bool hourly) { _hourly = hourly; NavigateHistory(_spotId, _expanded, replace: true); }
    private void NavigateHistory(string? spotId, Guid? sessionId = null, bool replace = false)
    {
        var path = HistoryPath(spotId, sessionId);
        if (!string.Equals(Navigation.Uri, Navigation.ToAbsoluteUri(path).AbsoluteUri, StringComparison.Ordinal))
            Navigation.NavigateTo(path, new NavigationOptions { ReplaceHistoryEntry = replace });
    }
    private string HistoryPath(string? spotId, Guid? sessionId = null, bool? allSessions = null, int? page = null)
    {
        var path = spotId is null ? "/history" : "/history/spots/" + Uri.EscapeDataString(spotId);
        if (spotId is not null && sessionId is { } id) path += "/" + id.ToString("D");
        var query = new List<KeyValuePair<string, string>>();
        if (allSessions ?? _allSessions) query.Add(new("view", "all"));
        if (_query.Length > 0) query.Add(new("q", _query));
        if (_days > 0) query.Add(new("days", _days.ToString(CultureInfo.InvariantCulture)));
        if (_class.Length > 0) query.Add(new("class", _class));
        if ((page ?? _page) > 1) query.Add(new("page", (page ?? _page).ToString(CultureInfo.InvariantCulture)));
        if (_hourly) query.Add(new("hourly", "1"));
        if (query.Count > 0) path += "?" + string.Join("&", query.Select(pair => pair.Key + "=" + Uri.EscapeDataString(pair.Value)));
        return path;
    }
    private static IReadOnlyDictionary<string, long> AggregateTotals(IEnumerable<LootHistoryEntry> sessions) => sessions.SelectMany(session => session.Totals).GroupBy(pair => pair.Key, StringComparer.Ordinal).ToDictionary(group => group.Key, group => group.Sum(pair => pair.Value), StringComparer.Ordinal);
    private bool IsCurrent(LootHistoryEntry session) => State.HasSession && session.SessionId == State.SessionId;
    private IReadOnlyDictionary<string, long> SessionTotals(LootHistoryEntry session) =>
        IsCurrent(session) ? State.Loot.Totals : session.Totals;
    private async Task Edit(LootHistoryEntry session)
    {
        PrepareEdit(session);
        await JS.InvokeVoidAsync("grindcrest.showDialog", "history-edit");
    }
    private void PrepareEdit(LootHistoryEntry session)
    {
        _target = session; _dialogError = null;
        _editClass = session.CharacterClass ?? "";
        _editRows = session.Totals.Keys.Concat(LootSpotCatalog.GetRequired(session.SpotId).AllowedItems).Distinct(StringComparer.Ordinal)
            .OrderByDescending(name => session.Totals.GetValueOrDefault(name)).ThenBy(name => name)
            .Select(name => new EditRow { Name = name, Quantity = session.Totals.GetValueOrDefault(name).ToString(CultureInfo.InvariantCulture) }).ToList();
    }
    private async Task AskDelete(LootHistoryEntry session) { _target = session; await JS.InvokeVoidAsync("grindcrest.showDialog", "history-confirm"); }
    private async Task CloseDialogs()
    {
        if (_disposed) return;
        await JS.InvokeVoidAsync("grindcrest.closeDialog", "history-edit");
        if (_disposed) return;
        await JS.InvokeVoidAsync("grindcrest.closeDialog", "history-confirm");
        if (!_disposed) _dialogError = null;
    }
    private async Task SaveEdit()
    {
        if (_target is null) return;
        var totals = new Dictionary<string, long>(StringComparer.Ordinal);
        foreach (var row in _editRows)
        {
            if (!long.TryParse(row.Quantity, NumberStyles.None, CultureInfo.InvariantCulture, out var quantity) || quantity < 0) { _dialogError = F("Bitte gib für „{0}“ eine gültige ganze Menge ab 0 ein.", ItemLabel(row.Name)); return; }
            totals[row.Name] = quantity;
        }
        if (await Act(() => Tracker.UpdateHistoryLootAsync(_target.SessionId, totals, _editClass))) await CloseDialogs(); else _dialogError = ActionError ?? State.Status;
    }
    private async Task ConfirmDelete()
    {
        if (_target is null) return;
        var target = _target.SessionId;
        await CloseDialogs();
        if (await Act(() => Tracker.DeleteHistoryAsync(target))) { _page = Math.Min(_page, _spotId is null ? AllPageCount : PageCount); NavigateHistory(_spotId, null, replace: true); }
    }
    private IReadOnlyList<LootColumn> BuildLootColumns(LootSpotPresentation profile, IReadOnlyList<LootHistoryEntry> sessions)
    {
        var hours = sessions.Where(session => session.Duration > TimeSpan.Zero).Sum(session => Hours(session.Duration));
        var totals = AggregateTotals(sessions);
        return new[] { profile.TrashItemName }
            .Concat(LootSpotCatalog.GetRequired(profile.SpotId).AllowedItems)
            .Concat(totals.Keys)
            .Distinct(StringComparer.Ordinal)
            .Select((name, index) => new
            {
                Column = new LootColumn(name, hours > 0 && totals.GetValueOrDefault(name) > 0
                    ? SilverValuation.Calculate(new Dictionary<string, long>(StringComparer.Ordinal) { [name] = totals.GetValueOrDefault(name) }, Tracker.Prices, Tracker.Preferences.Tax).AfterTax / hours
                    : 0),
                Index = index
            })
            .OrderBy(item => ColumnPosition(profile.SpotId, item.Column.Name))
            .ThenBy(item => item.Column.Name == profile.TrashItemName ? 0 : 1)
            .ThenByDescending(item => item.Column.SilverPerHour)
            .ThenBy(item => item.Index)
            .Select(item => item.Column)
            .ToArray();
    }
    private DotNetObjectReference<HistoryDashboard>? _dragReference;
    private bool _disposed;
    public override void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        _dragReference?.Dispose();
        _dragReference = null;
        base.Dispose();
    }
    private int ColumnPosition(string spotId, string name)
    {
        if (!Tracker.Preferences.LootColumnOrders.TryGetValue(spotId, out var order)) return int.MaxValue;
        var index = Array.IndexOf(order, name);
        return index < 0 ? int.MaxValue : index;
    }
    [JSInvokable]
    public async Task SaveColumnOrder(string spotId, string[] order)
    {
        if (_disposed || spotId != _spotId || Acting || State.IsBusy || Profile(spotId) is not { } profile) return;
        var current = BuildLootColumns(profile, SpotSessions.ToArray()).Select(column => column.Name).ToArray();
        if (order.Length != current.Length || order.Distinct(StringComparer.Ordinal).Count() != current.Length || current.Except(order, StringComparer.Ordinal).Any()) return;
        var orders = Tracker.Preferences.LootColumnOrders.ToDictionary(pair => pair.Key, pair => pair.Value);
        orders[spotId] = order;
        _columnStatus = null;
        var saved = await SavePreferenceChange(p => p with { LootColumnOrders = orders });
        if (_disposed || spotId != _spotId) return;
        if (saved) _columnStatus = "Spaltenreihenfolge gespeichert.";
        StateHasChanged();
    }
    private IEnumerable<KeyValuePair<string, long>> ChronologicalLoot(LootHistoryEntry session)
    {
        var trash = Profile(session.SpotId)?.TrashItemName;
        if (trash is not null) yield return new(trash, session.Totals.GetValueOrDefault(trash));
        foreach (var item in session.Totals.Where(item => item.Value > 0 && item.Key != trash &&
            (IsFavorite(item.Key) || Tracker.Prices.TryGetQuote(item.Key, out var price) && price.UnitPrice > 200_000_000m))
            .OrderByDescending(item => item.Value).ThenBy(item => item.Key, StringComparer.Ordinal))
            yield return item;
    }
    private string ColumnPriceTooltip(string name)
    {
        var price = Tracker.Prices.TryGetQuote(name, out var quote)
            ? F("{0} Silber / Stück vor Steuer", Number(quote.UnitPrice)) + (quote.IsStale ? T(" (Cache, veraltet)") : "")
            : T("Stückpreis fehlt");
        return ItemLabel(name) + " · " + price + T(" · Unter dem Icon: Netto-Ertrag / h aus den gefilterten Sessions. Klicken für Favorit; ziehen oder Alt + Pfeil links/rechts zum Verschieben.");
    }
    private bool IsFavorite(string name) => Tracker.Preferences.FavoriteItems.Contains(name, StringComparer.Ordinal);
    private Task KeyboardFavorite(MouseEventArgs e, string name) => e.Detail == 0
        ? ToggleSessionFavorite(_spotId ?? "", name) : Task.CompletedTask;
    [JSInvokable]
    public async Task ToggleSessionFavorite(string spotId, string name)
    {
        if (_disposed || spotId != _spotId || Acting || State.IsBusy || Profile(spotId) is not { } profile ||
            !BuildLootColumns(profile, SpotSessions.ToArray()).Any(column => column.Name == name)) return;
        await SavePreferenceChange(p => p with
        {
            FavoriteItems = p.FavoriteItems.Contains(name, StringComparer.Ordinal) ? p.FavoriteItems.Where(item => item != name).ToArray()
                : p.FavoriteItems.Append(name).ToArray()
        });
        if (_disposed || spotId != _spotId) return;
        StateHasChanged();
    }
    private static string SessionTableWidth(int lootColumnCount) =>
        $"min-width:{908 + Math.Max(1, lootColumnCount) * 88}px";
}
