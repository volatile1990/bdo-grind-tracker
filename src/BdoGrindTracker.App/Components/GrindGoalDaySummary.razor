@inherits TrackerComponentBase

@{
    var sessions = Tracker.History.GroupBy(s => s.SessionId).Select(g => g.MaxBy(s => s.UpdatedAt)!)
        .Where(s => DateOnly.FromDateTime(s.StartedAt.LocalDateTime) == Day)
        .OrderByDescending(s => s.StartedAt).ToArray();
    var duration = TimeSpan.FromTicks(sessions.Sum(s => s.Duration.Ticks));
    var silver = sessions.Sum(s => s.SilverAfterTax);
    var totals = sessions.SelectMany(s => s.Totals).GroupBy(item => item.Key, StringComparer.Ordinal)
        .ToDictionary(g => g.Key, g => g.Sum(item => item.Value), StringComparer.Ordinal);
    var partial = sessions.Any(s => !s.SilverIsComplete) ? " *" : "";
}
<section class="gg-day-summary" aria-label="Zusammenfassung des ausgewählten Tages">
    <div class="section-title"><h2>Sessions · @Day.ToString("dd.MM.yyyy")</h2></div>
    <div class="history-overview-stats">
        <div><span>SESSIONS</span><strong>@sessions.Length</strong></div>
        <div><span>GRINDZEIT</span><strong>@ShortDuration(duration)</strong></div>
        <div><span>SILBER NETTO</span><strong class="gold">@Silver(silver)@partial</strong></div>
        <div><span>Ø SILBER / STUNDE</span><strong>@(duration > TimeSpan.Zero ? Silver(Hourly(silver, duration)) : "—")@partial</strong></div>
    </div>
    @if (partial.Length > 0) { <p class="valuation-note">* Enthält Sessions mit unvollständigen Silberwerten.</p> }
    <section class="panel chronological-history" aria-label="Sessions des ausgewählten Tages">
        @foreach (var session in sessions)
        {
            <details class="chronological-session-card" @key="session.SessionId">
                                        <summary class="chronological-session-header" style="@SpotBackgroundStyle(Profile(session.SpotId), shaded: true)">
                            <span class="chronological-date"><strong>@session.StartedAt.ToLocalTime().ToString("dd.MM.yy", German)</strong><small>@session.StartedAt.ToLocalTime().ToString("HH:mm 'Uhr'", German)</small></span>
                            <span class="chronological-spot"><AssetImage Src="@("assets/spot-icons/" + Profile(session.SpotId)?.IconFileName)" Alt="" Class="chronological-spot-icon" /><span><strong>@SpotName(session.SpotId)</strong><small>@(session.CharacterClass ?? "Klasse nicht erkannt")</small>@if (session.GarmothLocallyModified) { <small class="session-local-correction">Lokal korrigiert; Garmoth unverändert</small> }</span></span>
                            <span class="chronological-loot-preview">
                                @foreach (var item in ChronologicalLoot(session))
                                {
                                    <span class="chronological-loot-badge" title="@ItemLabel(item.Key)"><AssetImage Src="@ItemIcon(item.Key)" Alt="@ItemLabel(item.Key)" Class="item-image" /><small>@Number(item.Value)</small></span>
                                }
                            </span>
                            <span class="chronological-session-duration"><small>GRINDZEIT</small><strong>@ShortDuration(session.Duration)</strong><small class="session-agris-time" title="@HistoryPresentation.AgrisTime(session).Description" aria-label="@HistoryPresentation.AgrisTime(session).Description">Agris @HistoryPresentation.AgrisTime(session).Duration</small></span>
                            <span class="chronological-session-experience @(HistoryPresentation.Experience(session).IsLoss ? "is-loss" : "")" title="@HistoryPresentation.Experience(session).Description"><small>ERFAHRUNG</small><strong class="experience-gain">@HistoryPresentation.Experience(session).Gain</strong>@if (HistoryPresentation.Experience(session).HasObservation) { <small class="experience-hourly">@HistoryPresentation.Experience(session).Hourly / h</small> }</span>
                            <span class="chronological-session-silver"><strong>@Silver(session.SilverAfterTax)@(!session.SilverIsComplete ? " *" : "")</strong><small>@Silver(Hourly(session.SilverAfterTax, session.Duration)) / h</small></span>
                            <span class="chronological-expand" aria-hidden="true"><AppIcon Name="chevron" /></span>
                        </summary>
                <div class="chronological-session-details">
                    <LootTable Totals="session.Totals" DurationTicks="session.Duration.Ticks"
                        TrashName="@(Profile(session.SpotId)?.TrashItemName)" Title="Loot der Session"
                        Subtitle="Mengen und Bewertung mit aktuellen Preisen" />
                </div>
            </details>
        }
        @if (sessions.Length == 0)
        {
            <div class="empty-state"><AppIcon Name="history" /><h3>Keine Sessions an diesem Tag</h3><p>Wähle einen anderen Tag im Kalender.</p></div>
        }
    </section>
    @if (sessions.Length > 0)
    {
        <LootTable @key="Day" Totals="totals" DurationTicks="duration.Ticks" Title="Alle Drops des Tages"
            Subtitle="Alle Sessions dieses Tages · Mengen zusammengefasst · Bewertung mit aktuellen Preisen" />
    }
</section>

@code {
    private IEnumerable<KeyValuePair<string, long>> ChronologicalLoot(LootHistoryEntry session)
    {
        var trash = Profile(session.SpotId)?.TrashItemName;
        if (trash is not null) yield return new(trash, session.Totals.GetValueOrDefault(trash));
        foreach (var item in session.Totals.Where(item => item.Value > 0 && item.Key != trash &&
            (IsFavorite(item.Key) || Tracker.Prices.TryGetQuote(item.Key, out var price) && price.UnitPrice > 200_000_000m))
            .OrderByDescending(item => item.Value).ThenBy(item => item.Key, StringComparer.Ordinal))
            yield return item;
    }
    private bool IsFavorite(string name) => Tracker.Preferences.FavoriteItems.Contains(name, StringComparer.Ordinal);
    [Parameter] public DateOnly Day { get; set; }
}

