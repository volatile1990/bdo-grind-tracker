@inherits TrackerComponentBase

@{
    var sessions = Tracker.History.GroupBy(s => s.SessionId).Select(g => g.MaxBy(s => s.UpdatedAt)!)
        .Where(s => DateOnly.FromDateTime(s.StartedAt.LocalDateTime) == Day)
        .OrderByDescending(s => s.StartedAt).ToArray();
    var duration = TimeSpan.FromTicks(sessions.Sum(s => s.Duration.Ticks));
    var silver = sessions.Sum(s => s.SilverAfterTax);
    var totals = sessions.SelectMany(s => s.Totals).GroupBy(item => item.Key, StringComparer.Ordinal)
        .ToDictionary(g => g.Key, g => g.Sum(item => item.Value), StringComparer.Ordinal);
    var partial = sessions.Any(s => !s.SilverIsComplete) ? " *" : "";
}
<section class="gg-day-summary" aria-label="@T("Zusammenfassung des ausgewählten Tages")">
    <div class="section-title"><h2>Sessions · @Day.ToString("d", UiCulture)</h2></div>
    <div class="history-overview-stats">
        <div><span>SESSIONS</span><strong>@sessions.Length</strong></div>
        <div><span>@T("GRINDZEIT")</span><strong>@ShortDuration(duration)</strong></div>
        <div><span>@T("SILBER NETTO")</span><strong class="gold">@Silver(silver)@partial</strong></div>
        <div><span>@T("Ø SILBER / STUNDE")</span><strong>@(duration > TimeSpan.Zero ? Silver(Hourly(silver, duration)) : "—")@partial</strong></div>
    </div>
    @if (partial.Length > 0) { <p class="valuation-note">@T("* Enthält Sessions mit unvollständigen Silberwerten.")</p> }
    <section class="panel chronological-history" aria-label="@T("Sessions des ausgewählten Tages")">
        @foreach (var session in sessions)
        {
            <details class="chronological-session-card" @key="session.SessionId">
                                        <summary class="chronological-session-header" style="@SpotBackgroundStyle(Profile(session.SpotId), shaded: true)">
                            <span class="chronological-date"><strong>@session.StartedAt.ToLocalTime().ToString("d", UiCulture)</strong><small>@session.StartedAt.ToLocalTime().ToString("t", UiCulture)</small></span>
                            <span class="chronological-spot"><AssetImage Src="@("assets/spot-icons/" + Profile(session.SpotId)?.IconFileName)" Alt="" Class="chronological-spot-icon" /><span><strong>@SpotName(session.SpotId)</strong><small>@T(session.CharacterClass ?? "Klasse nicht erkannt")</small>@if (session.GarmothLocallyModified) { <small class="session-local-correction">@T("Lokal korrigiert; Garmoth unverändert")</small> }</span></span>
                            <span class="chronological-loot-preview">
                                @foreach (var item in ChronologicalLoot(session))
                                {
                                    <span class="chronological-loot-badge" title="@ItemLabel(item.Key)"><AssetImage Src="@ItemIcon(item.Key)" Alt="@ItemLabel(item.Key)" Class="item-image" /><small>@Number(item.Value)</small></span>
                                }
                            </span>
                            <span class="chronological-session-duration"><small>@T("GRINDZEIT")</small><strong>@ShortDuration(session.Duration)</strong><small class="session-agris-time" title="@HistoryPresentation.AgrisTime(session, Tracker.Preferences.UiLanguage).Description" aria-label="@HistoryPresentation.AgrisTime(session, Tracker.Preferences.UiLanguage).Description">Agris @HistoryPresentation.AgrisTime(session, Tracker.Preferences.UiLanguage).Duration</small></span>
                            <span class="chronological-session-experience @(HistoryPresentation.Experience(session, Tracker.Preferences.UiLanguage).IsLoss ? "is-loss" : "")" title="@HistoryPresentation.Experience(session, Tracker.Preferences.UiLanguage).Description"><small>@T("ERFAHRUNG")</small><strong class="experience-gain">@HistoryPresentation.Experience(session, Tracker.Preferences.UiLanguage).Gain</strong>@if (HistoryPresentation.Experience(session, Tracker.Preferences.UiLanguage).HasObservation) { <small class="experience-hourly">@HistoryPresentation.Experience(session, Tracker.Preferences.UiLanguage).Hourly / h</small> }</span>
                            <span class="chronological-session-silver"><strong>@Silver(session.SilverAfterTax)@(!session.SilverIsComplete ? " *" : "")</strong><small>@Silver(Hourly(session.SilverAfterTax, session.Duration)) / h</small></span>
                            <span class="chronological-expand" aria-hidden="true"><AppIcon Name="chevron" /></span>
                        </summary>
                <div class="chronological-session-details">
                    <LootTable Totals="session.Totals" DurationTicks="session.Duration.Ticks"
                        TrashName="@(Profile(session.SpotId)?.TrashItemName)" Title="@T("Loot der Session")"
                        Subtitle="@T("Mengen und Bewertung mit aktuellen Preisen")" />
                </div>
            </details>
        }
        @if (sessions.Length == 0)
        {
            <div class="empty-state"><AppIcon Name="history" /><h3>@T("Keine Sessions an diesem Tag")</h3><p>@T("Wähle einen anderen Tag im Kalender.")</p></div>
        }
    </section>
    @if (sessions.Length > 0)
    {
        <LootTable @key="Day" Totals="totals" DurationTicks="duration.Ticks" Title="@T("Alle Drops des Tages")"
            Subtitle="@T("Alle Sessions dieses Tages · Mengen zusammengefasst · Bewertung mit aktuellen Preisen")" />
    }
</section>

@code {
    private IEnumerable<KeyValuePair<string, long>> ChronologicalLoot(LootHistoryEntry session)
    {
        var trash = Profile(session.SpotId)?.TrashItemName;
        if (trash is not null) yield return new(trash, session.Totals.GetValueOrDefault(trash));
        foreach (var item in session.Totals.Where(item => item.Value > 0 && item.Key != trash &&
            (IsFavorite(item.Key) || Tracker.Prices.TryGetQuote(item.Key, out var price) && price.UnitPrice > 200_000_000m))
            .OrderByDescending(item => item.Value).ThenBy(item => item.Key, StringComparer.Ordinal))
            yield return item;
    }
    private bool IsFavorite(string name) => Tracker.Preferences.FavoriteItems.Contains(name, StringComparer.Ordinal);
    [Parameter] public DateOnly Day { get; set; }
}

