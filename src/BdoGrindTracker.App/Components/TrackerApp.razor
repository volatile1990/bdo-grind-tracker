@namespace BdoGrindTracker.App.Components
@inherits TrackerComponentBase
@inject IJSRuntime JS

<div class="app-shell" data-app-ready="true">
    <aside class="sidebar" aria-label="Hauptnavigation">
        <a class="brand" href="#" aria-label="Grindcrest · Live-Session" @onclick="() => NavigateAsync(Page.Live)" @onclick:preventDefault>
            <AssetImage Src="assets/branding/grindcrest-header.png" Alt="" Class="brand-mark" Fallback="spark" />
            <span><strong>GRINDCREST</strong><small>BLACK DESERT TRACKER</small></span>
        </a>
        <div class="nav-caption">DEIN ABENTEUER</div>
        <nav>
            <button class="nav-item @(_page == Page.Live ? "active" : "")" aria-label="Live-Session" title="Live-Session" aria-current="@(_page == Page.Live ? "page" : null)" @onclick="() => NavigateAsync(Page.Live)"><AppIcon Name="live" /><span>Live-Session</span>@if (State.IsRunning) { <span class="nav-live-dot"></span> }</button>
            <button class="nav-item @(_page == Page.History ? "active" : "")" aria-label="Verlauf" title="Verlauf" aria-current="@(_page == Page.History ? "page" : null)" @onclick="() => NavigateAsync(Page.History)"><AppIcon Name="history" /><span>Verlauf</span><span class="nav-count">@Tracker.History.Count</span></button>
            <button class="nav-item @(_page == Page.Settings ? "active" : "")" aria-label="Einstellungen" title="Einstellungen" aria-current="@(_page == Page.Settings ? "page" : null)" @onclick="() => NavigateAsync(Page.Settings)"><AppIcon Name="settings" /><span>Einstellungen</span></button>
        </nav>
        <div class="sidebar-bottom">
            <div class="local-note"><AppIcon Name="shield" /><div><strong>Dein Loot. Deine Daten.</strong><span>Verlauf lokal auf deinem PC</span></div></div>
            <div class="sidebar-version"><span>Grindcrest</span><span>@Version</span></div>
        </div>
    </aside>
    <div class="workspace">
        <header class="topbar">
            <div class="breadcrumb">Grindcrest <span>/</span> <strong>@PageLabel</strong></div>
            <div class="topbar-right"><span class="region-badge">@Tracker.Preferences.MarketRegion.ToUpperInvariant()</span><span class="connection"><span class="status-dot @(State.IsRunning ? "running" : State.IsError ? "error" : "")"></span>@(State.IsDemo ? "Demo-Modus" : State.IsRunning ? "Tracking aktiv" : State.HasSession ? "Pausiert" : "Bereit")</span></div>
        </header>
        <main id="main-content">
            @if (_page == Page.Live) { <LiveDashboard OnSettings="() => NavigateAsync(Page.Settings)" /> }
            else if (_page == Page.History) { <HistoryDashboard OnLive="() => NavigateAsync(Page.Live)" /> }
            else { <TrackerSettings /> }
        </main>
        <footer class="statusbar @(State.IsError ? "has-error" : "")" role="status" aria-live="polite">
            <span class="status-message"><span class="status-dot @(State.IsError ? "error" : State.IsRunning ? "running" : "")"></span>@State.Status</span>
            @if (State.IsRecording) { <span class="recording-badge" title="@State.RecordingPath"><span class="record-dot"></span>Aufzeichnung</span> }
        </footer>
    </div>
</div>

@code {
    private enum Page { Live, History, Settings }
    private Page _page;
    private async Task NavigateAsync(Page page)
    {
        _page = page;
        await JS.InvokeVoidAsync("grindcrest.scrollTop", false);
    }
    private string PageLabel => _page switch { Page.History => "Verlauf", Page.Settings => "Einstellungen", _ => "Live-Session" };
    private static string Version => typeof(TrackerApp).Assembly.GetCustomAttributes(typeof(System.Reflection.AssemblyInformationalVersionAttribute), false)
        .OfType<System.Reflection.AssemblyInformationalVersionAttribute>().FirstOrDefault()?.InformationalVersion.Split('+')[0] ?? "";
}
