<span class="combat-stats @CategoryClass @(Compact ? "combat-stats-compact" : "") @(!Known ? "combat-stats-unknown" : "")" role="group" aria-label="@Description" title="@Description">
    @if (Known)
    {
        <span class="combat-stats-values"><span>AP <strong>@Number(ApplicableValue!.Ap!.Value)</strong></span><span>DP <strong>@Number(ApplicableValue.Dp!.Value)</strong></span></span>
        <span class="combat-stats-category">@CategoryLabel</span>
        @if (LastKnown && !Saved) { <span class="combat-stats-age">Zuletzt erkannt</span> }
    }
    else
    {
        <span>AP/DP @(Saved ? "nicht erfasst" : "noch nicht erkannt")</span>
    }
</span>

@code {
    [Parameter] public CombatStatsState? Value { get; set; }
    [Parameter] public string? SpotId { get; set; }
    [Parameter] public bool LastKnown { get; set; }
    [Parameter] public bool Saved { get; set; }
    [Parameter] public bool Compact { get; set; }
    private CombatStatsState? ApplicableValue => CombatStatsSpotRules.ForSpot(Value, SpotId);
    private bool Known => ApplicableValue is not null;
    private string CategoryLabel => ApplicableValue?.Category switch
    {
        CombatStatsCategory.General => "Allgemein",
        CombatStatsCategory.Edania => "Edania",
        CombatStatsCategory.Demihuman => "Halbmenschen",
        CombatStatsCategory.Kamasylvian => "Kamasilvia",
        _ => "Nicht erkannt",
    };
    private string CategoryClass => !Known ? "" : ApplicableValue!.Category switch
    {
        CombatStatsCategory.General => "combat-stats-general",
        CombatStatsCategory.Edania => "combat-stats-edania",
        CombatStatsCategory.Demihuman => "combat-stats-demihuman",
        CombatStatsCategory.Kamasylvian => "combat-stats-kamasylvian",
        _ => "",
    };
    private string Description => !Known
        ? Saved ? "Für diese Session wurden keine AP/DP erfasst." : "AP/DP im Spiel noch nicht erkannt."
        : $"AP {Number(ApplicableValue!.Ap!.Value)}, DP {Number(ApplicableValue.Dp!.Value)} · {CategoryLabel} · " +
            (Saved ? "In dieser Session erfasst" : LastKnown ? "Zuletzt im Spiel erkannt" : "Im Spiel erkannt") +
            (ApplicableValue.ObservedAt is { } observed ? $" am {observed.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss", German)}" : "");
}
