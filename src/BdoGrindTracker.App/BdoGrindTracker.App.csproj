<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>BdoGrindTracker</AssemblyName>
    <Product>Grindcrest</Product>
    <Title>Grindcrest</Title>
    <AssemblyTitle>Grindcrest</AssemblyTitle>
    <Description>Passive Black Desert loot and grind-session tracker</Description>
    <ApplicationIcon>..\..\data\branding\grindcrest.ico</ApplicationIcon>
    <RootNamespace>BdoGrindTracker.App</RootNamespace>
    <Version>1.2.0</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <UpdateRepositoryUrl Condition="'$(UpdateRepositoryUrl)' == ''">https://github.com/volatile1990/bdo-grind-tracker</UpdateRepositoryUrl>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="9.0.120" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <AssemblyMetadata Include="UpdateRepositoryUrl" Value="$(UpdateRepositoryUrl)" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <WebUiAsset Include="..\..\data\**\*.png;..\..\data\**\*.jpg;..\..\data\**\*.json;..\..\data\**\*.ico" Exclude="..\..\data\ocr\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BdoGrindTracker.Core\BdoGrindTracker.Core.csproj" />
    <ProjectReference Include="..\BdoGrindTracker.Ocr\BdoGrindTracker.Ocr.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\data\branding\grindcrest-header.png" LogicalName="BdoGrindTracker.App.Branding.grindcrest-header.png" />
    <EmbeddedResource Include="..\..\data\ocr\loot-scroll\*.png" LogicalName="BdoGrindTracker.App.LootScroll.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\data\ocr\agris\*.png" LogicalName="BdoGrindTracker.App.Agris.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\data\branding\grindcrest.ico" LogicalName="BdoGrindTracker.App.Branding.grindcrest.ico" />
    <Content Include="..\..\data\branding\*" Link="data\branding\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\data\items.en.txt')">
    <Content Include="..\..\data\items.en.txt" Link="data\items.en.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\data\icons')">
    <Content Include="..\..\data\icons\**\*.png" Link="data\icons\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\data\icons\SOURCES.md" Link="data\icons\SOURCES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\data\icons\catalog.json" Link="data\icons\catalog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\data\spot-backgrounds')">
    <Content Include="..\..\data\spot-backgrounds\**\*.jpg" Link="data\spot-backgrounds\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\data\spot-icons')">
    <Content Include="..\..\data\spot-icons\**\*.png" Link="data\spot-icons\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\data\crystal-icons')">
    <Content Include="..\..\data\crystal-icons\**\*.png" Link="data\crystal-icons\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\data\class-icons')">
    <Content Include="..\..\data\class-icons\**\*.png" Link="data\class-icons\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\data\class-icons\SOURCES.md" Link="data\class-icons\SOURCES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\data\ui-icons')">
    <Content Include="..\..\data\ui-icons\**\*.png" Link="data\ui-icons\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\data\ui-icons\SOURCES.md" Link="data\ui-icons\SOURCES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\docs\BLAZOR_HYBRID.md" Link="docs\BLAZOR_HYBRID.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\OVERLAY.md" Link="docs\OVERLAY.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\GRIND_RATING.md" Link="docs\GRIND_RATING.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\*" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\README.md" Link="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\docs\ANALYSIS.md" Link="docs\ANALYSIS.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\docs\LOOT_POOLS.md" Link="docs\LOOT_POOLS.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\docs\SAFETY.md" Link="docs\SAFETY.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\docs\COMPANION_0_7_4_PARITY.md" Link="docs\COMPANION_0_7_4_PARITY.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\docs\CLASS_DETECTION.md" Link="docs\CLASS_DETECTION.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\docs\GARMOTH_INTEGRATION.md" Link="docs\GARMOTH_INTEGRATION.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\docs\SILVER_VALUATION.md" Link="docs\SILVER_VALUATION.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\docs\OCR_RECOVERY.md" Link="docs\OCR_RECOVERY.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\docs\BACKGROUND_OCR_REVIEW.md" Link="docs\BACKGROUND_OCR_REVIEW.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Keep the stable managed assembly identity used by the OCR friend assembly.
       The apphost resolves its embedded DLL name even under the branded EXE name. -->
  <Target Name="PublishGrindcrestLauncher" AfterTargets="Publish"
          Condition="Exists('$(PublishDir)$(AssemblyName).exe')">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)Grindcrest.exe" />
  </Target>
  <Target Name="CopyWebUiAssetsToBuild" AfterTargets="Build">
    <Copy SourceFiles="@(WebUiAsset)" DestinationFiles="@(WebUiAsset->'$(TargetDir)wwwroot\assets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyWebUiAssetsToPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(WebUiAsset)" DestinationFiles="@(WebUiAsset->'$(PublishDir)wwwroot\assets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <EmbeddedResource Include="Development/Garmoth320.json" LogicalName="Development.Garmoth320.json" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Development/**/*.cs" />
    <Content Remove="Development/**/*" />
    <None Remove="Development/**/*" />
  </ItemGroup>
</Project>
